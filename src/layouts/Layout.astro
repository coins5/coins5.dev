---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";


interface Props {
  title: string;
  description: string;
  lang: "en" | "es";
  ogImage?: string;
  canonicalUrl?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description,
  lang,
  ogImage = "/og-image.png",
  canonicalUrl,
  ogType = "website",
} = Astro.props;

// SEO length checks warning in development
if (title.length > 60) {
  console.warn(`[SEO Warning] Title is too long (${title.length} characters, max 60): "${title}"`);
}
if (description.length > 160) {
  console.warn(`[SEO Warning] Description is too long (${description.length} characters, max 160): "${description}"`);
}

const siteUrl = "https://coins5.dev";
const cleanPathname = Astro.url.pathname.replace(/\/$/, "");

// Construct localized path alternate variants
let enPath = "";
let esPath = "";

if (lang === "es") {
  // Spanish route (e.g. /es/something)
  esPath = cleanPathname || "/es";
  const pathWithoutEs = cleanPathname.replace(/^\/es/, "");
  enPath = pathWithoutEs || "/";
} else {
  // English route (root or subpath e.g. /services)
  enPath = cleanPathname || "/";
  esPath = `/es${cleanPathname === "" ? "" : cleanPathname}`;
}

// Format to absolute URLs
const formatUrl = (path: string) => {
  if (path === "/" || path === "") return `${siteUrl}/`;
  if (path === "/es") return `${siteUrl}/es/`;
  return `${siteUrl}${path}`;
};

const canonical = canonicalUrl || formatUrl(lang === "es" ? esPath : enPath);
const enUrl = formatUrl(enPath);
const esUrl = formatUrl(esPath);
const xDefaultUrl = enUrl;

// OG Image and Locale resolution
const ogImageUrl = ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`;
const currentLocale = lang === "es" ? "es_PE" : "en_US";
---

<!doctype html>
<html lang={lang} data-theme="sandstone-charcoal">
  <head>
    <!-- Basic Meta Tags -->
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />

    <!-- International hreflang Links -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={currentLocale} />
    <meta property="og:site_name" content="Coins5" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="bg-base-100 text-base-content min-h-screen flex flex-col antialiased selection:bg-secondary selection:text-secondary-content">
    <!-- Header / Navbar -->
    <Navbar />

    <!-- Main Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Conversion Event Tracking (Vanilla JS Event Delegation for perfect INP & Lighthouse) -->
    <script is:inline>
      (function() {
        // Register conversion events after browser becomes idle to prevent Blocking Time
        const initTracking = () => {
          document.body.addEventListener('click', (event) => {
            const link = event.target.closest('a');
            if (!link) return;

            const href = link.getAttribute('href') || '';
            const ctaText = link.innerText ? link.innerText.trim() : '';

            // 1. Primary CTA - Calendly (Discovery Call)
            if (href.includes('calendly.com')) {
              console.log('[Analytics] Primary Conversion Triggered: Calendly Discovery Call', {
                text: ctaText,
                destination: href,
                timestamp: new Date().toISOString()
              });

              // Push to Google Tag Manager / GA4 dataLayer securely
              window.dataLayer = window.dataLayer || [];
              window.dataLayer.push({
                event: 'primary_conversion_calendly',
                cta_label: ctaText,
                destination_url: href
              });
            }

            // 2. Secondary CTA - WhatsApp Business (Quick Quote)
            if (href.includes('wa.me') || href.includes('whatsapp.com')) {
              console.log('[Analytics] Secondary Conversion Triggered: WhatsApp Business Quote', {
                text: ctaText,
                destination: href,
                timestamp: new Date().toISOString()
              });

              window.dataLayer = window.dataLayer || [];
              window.dataLayer.push({
                event: 'secondary_conversion_whatsapp',
                cta_label: ctaText,
                destination_url: href
              });
            }
          });
        };

        // Leverage requestIdleCallback or setTimeout fallback to preserve Main Thread
        if ('requestIdleCallback' in window) {
          requestIdleCallback(() => initTracking(), { timeout: 2000 });
        } else {
          setTimeout(() => initTracking(), 100);
        }
      })();
    </script>
  </body>
</html>
