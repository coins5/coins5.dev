---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FloatingCta from "../components/FloatingCta.astro";
import CodeCopy from "../components/CodeCopy.astro";
import { SEO } from "astro-seo";
import { siteConfig } from "../config";
import Analytics from "@vercel/analytics/astro";
import { getOrganizationSchema, getPersonSchema } from "../utils/seo-schemas";

interface Props {
  title: string;
  description: string;
  lang: "en" | "es";
  keywords?: string[];
  ogImage?: string;
  canonicalUrl?: string;
  ogType?: "website" | "article";
  schema?: any;
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title,
  description,
  lang,
  keywords,
  ogImage,
  canonicalUrl,
  ogType = "website",
  schema,
  noindex = false,
  nofollow = false,
} = Astro.props;

// SEO length checks warning in development
if (title.length > 60) {
  console.warn(
    `[SEO Warning] Title is too long (${title.length} characters, max 60): "${title}"`,
  );
}
if (description.length > 160) {
  console.warn(
    `[SEO Warning] Description is too long (${description.length} characters, max 160): "${description}"`,
  );
}

const siteUrl = siteConfig.siteUrl.replace(/\/$/, ""); // Asegura que no termine en slash para evitar doble slash abajo
const currentPath = Astro.url.pathname.replace(/\/$/, "");

// Construcción limpia y robusta de las variantes de idioma
let enPath = "";
let esPath = "";

if (currentPath.startsWith("/es")) {
  esPath = currentPath;
  enPath = currentPath.replace(/^\/es/, "") || "";
} else {
  enPath = currentPath;
  esPath = `/es${currentPath}`;
}

// Convertir a URLs absolutas uniformes (todas terminan en / para cumplir el estándar canónico)
const enUrl = `${siteUrl}${enPath}/`;
const esUrl = `${siteUrl}${esPath}/`;
const xDefaultUrl = enUrl;

// Definimos la URL canónica y variantes de idioma (omitidas si la página es noindex)
const canonical = noindex ? undefined : (canonicalUrl || (lang === "es" ? esUrl : enUrl));
const languageAlternates = noindex
  ? undefined
  : [
      { hrefLang: "en", href: enUrl },
      { hrefLang: "es", href: esUrl },
      { hrefLang: "x-default", href: xDefaultUrl },
    ];

const defaultOgImage = `${siteUrl}/default-preview.png`;
const resolvedOgImage = ogImage
  ? ogImage.startsWith("http")
    ? ogImage
    : `${siteUrl}${ogImage.startsWith("/") ? "" : "/"}${ogImage}`
  : defaultOgImage;

const resolvedSchema = noindex
  ? null
  : (schema || [
      getOrganizationSchema(lang),
      getPersonSchema(),
    ]);
---

<!doctype html>
<html lang={lang} data-theme="sandstone-light">
  <head>
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem("theme");
          const initialTheme = savedTheme || "sandstone-light";
          document.documentElement.setAttribute("data-theme", initialTheme);
        } catch (e) {}
      })();
    </script>
    <!-- Basic Meta Tags -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Coins5.dev" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Configuración SEO centralizada (astro-seo) -->
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      nofollow={nofollow}
      languageAlternates={languageAlternates}
      openGraph={{
        basic: {
          title: title,
          type: ogType,
          image: resolvedOgImage,
          url: canonical || siteUrl,
        },
        optional: {
          description: description,
          siteName: "Coins5",
          locale: lang === "es" ? "es_PE" : "en_US",
        },
        image: {
          alt: `${title} | Coins5`,
          width: 1200,
          height: 630,
          type: "image/png",
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: "@coins5",
        creator: "@coins5",
        title: title,
        description: description,
        image: resolvedOgImage,
        imageAlt: `${title} | Coins5`,
      }}
      extend={{
        meta: [
          {
            name: "keywords",
            content:
              keywords?.join(", ") ||
              "coins5, software architecture, ai solutions",
          },
          { name: "author", content: "Robert Marlon Colca Manrique" },
        ],
      }}
    />

    <Analytics />

    <!-- Structured Data (JSON-LD) for Search & AI Engines -->
    {resolvedSchema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(resolvedSchema)}
      />
    )}
  </head>
  <body
    class="bg-base-100 text-base-content min-h-screen flex flex-col antialiased selection:bg-secondary selection:text-secondary-content"
  >
    <Navbar />
    <main class="grow">
      <slot />
    </main>
    <Footer />
    <FloatingCta lang={lang} />
    <CodeCopy />

    <script is:inline>
      (function () {
        const initTracking = () => {
          document.body.addEventListener("click", (event) => {
            const link = event.target.closest("a");
            if (!link) return;

            const href = link.getAttribute("href") || "";
            const ctaText = link.innerText ? link.innerText.trim() : "";

            if (href.includes("calendly.com")) {
              console.log(
                "[Analytics] Primary Conversion Triggered: Calendly Discovery Call",
                {
                  text: ctaText,
                  destination: href,
                  timestamp: new Date().toISOString(),
                },
              );
              window.dataLayer = window.dataLayer || [];
              window.dataLayer.push({
                event: "primary_conversion_calendly",
                cta_label: ctaText,
                destination_url: href,
              });
            }

            if (href.includes("wa.me") || href.includes("whatsapp.com")) {
              console.log(
                "[Analytics] Secondary Conversion Triggered: WhatsApp Business Quote",
                {
                  text: ctaText,
                  destination: href,
                  timestamp: new Date().toISOString(),
                },
              );
              window.dataLayer = window.dataLayer || [];
              window.dataLayer.push({
                event: "secondary_conversion_whatsapp",
                cta_label: ctaText,
                destination_url: href,
              });
            }
          });
        };

        if ("requestIdleCallback" in window) {
          requestIdleCallback(() => initTracking(), { timeout: 2000 });
        } else {
          setTimeout(() => initTracking(), 100);
        }
      })();
    </script>
  </body>
</html>
