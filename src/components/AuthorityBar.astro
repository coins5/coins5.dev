---
import { Award, Cpu, Cloud, CheckCircle2 } from "@lucide/astro";

const { pathname } = Astro.url;
const cleanPathname = pathname.replace(/\/$/, "");
const isEs = cleanPathname.startsWith("/es/") || cleanPathname === "/es";

// Milestones configuration
const milestones = isEs
  ? [
      {
        icon: Award,
        label: "Ex-CTO Strategio",
        metric: "Ganador Startup Perú",
        sub: "MVP en 12 semanas",
      },
      {
        icon: Cpu,
        label: "NubaNutrición",
        metric: "Modelos Clínicos de IA",
        sub: "Planes automáticos",
      },
      {
        icon: Cloud,
        label: "PróximaBolilla",
        metric: "Arquitectura Cloud Concurrente",
        sub: "Simulación masiva",
      },
      {
        icon: CheckCircle2,
        label: "12+ Años de Experiencia",
        metric: "Clean Architecture & SOLID",
        sub: "Cero deuda técnica",
      },
    ]
  : [
      {
        icon: Award,
        label: "Ex-CTO Strategio",
        metric: "Startup Perú Winner",
        sub: "MVP in 12 weeks",
      },
      {
        icon: Cpu,
        label: "NubaNutrición",
        metric: "Clinical AI Models",
        sub: "Dynamic dietary engine",
      },
      {
        icon: Cloud,
        label: "PróximaBolilla",
        metric: "High-Concurrency Cloud",
        sub: "Real-time simulation",
      },
      {
        icon: CheckCircle2,
        label: "12+ Years Experience",
        metric: "Clean Architecture & SOLID",
        sub: "Zero technical debt",
      },
    ];

const labelText = isEs
  ? "Historial de ingeniería validado en producción:"
  : "Engineering track record validated in production:";
---

<div
  class="w-full py-5 z-20 border-y transition-colors duration-300"
  style="background-color: var(--authority-bg); border-color: var(--authority-border);"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-4 lg:gap-6">
      <!-- Section Micro-Tag -->
      <span
        class="text-[11px] font-mono tracking-widest uppercase text-center lg:text-left select-none font-bold shrink-0 opacity-80"
        style="color: var(--color-text-body);"
      >
        {labelText}
      </span>

      <!-- Milestones Metric Cards -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 sm:gap-3 w-full lg:w-auto">
        {
          milestones.map((m) => {
            const Icon = m.icon;
            return (
              <div
                class="flex items-center gap-2.5 px-3 py-2 rounded-lg border transition-all duration-300 hover:scale-[1.01]"
                style="background-color: var(--card-bg); border-color: var(--card-border);"
              >
                <div class="p-1 rounded bg-secondary/10 text-secondary shrink-0">
                  <Icon class="w-3.5 h-3.5" stroke-width="2" />
                </div>
                <div class="text-left min-w-0">
                  <span class="block text-xs font-bold text-primary font-mono truncate">
                    {m.label}
                  </span>
                  <span
                    class="block text-[10px] font-mono truncate"
                    style="color: var(--color-text-body);"
                  >
                    {m.metric}
                  </span>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</div>
