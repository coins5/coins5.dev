---
const { pathname } = Astro.url;
const cleanPathname = pathname.replace(/\/$/, "");
const isEs = cleanPathname.startsWith("/es/") || cleanPathname === "/es";

// Milestones configuration
const milestones = isEs
  ? [
      { text: "Ex-CTO Strategio", badge: "Ganador Startup Perú" },
      { text: "NubaNutrición", badge: "IA & Salud" },
      { text: "PróximaBolilla", badge: "Cloud & Simulación" }
    ]
  : [
      { text: "Ex-CTO Strategio", badge: "Startup Perú Winner" },
      { text: "NubaNutrición", badge: "AI & Health" },
      { text: "PróximaBolilla", badge: "Cloud & Simulation" }
    ];

const labelText = isEs 
  ? "Tecnología respaldada por experiencia real:" 
  : "Technology backed by proven real-world experience:";
---

<div class="w-full bg-base-200 border-y border-stone-500/10 py-5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-5">
      <!-- Authority Label -->
      <span class="text-[11px] tracking-wider uppercase text-stone-500 font-mono text-center lg:text-left select-none">
        {labelText}
      </span>
      
      <!-- Milestones Cards -->
      <div class="flex flex-wrap items-center justify-center gap-3 lg:gap-4">
        {milestones.map((m) => (
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-transparent hover:border-stone-500/20 bg-base-100/40 hover:bg-base-100 transition-all duration-300 shadow-sm">
            <span class="text-xs font-semibold text-stone-200 font-mono tracking-tight">{m.text}</span>
            <span class="badge badge-sm badge-outline text-[9px] text-stone-400 font-mono border-stone-500/30 uppercase tracking-wider py-0 px-1.5 select-none">{m.badge}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
