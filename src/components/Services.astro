---
import { Rocket, Cpu, Check, Calendar, MessageSquare, ArrowUpRight } from "@lucide/astro";
import { siteConfig, getWhatsAppUrl } from "../config";

const { pathname } = Astro.url;
const cleanPathname = pathname.replace(/\/$/, "");
const isEs = cleanPathname.startsWith("/es/") || cleanPathname === "/es";

// Translations dictionary
const content = isEs
  ? {
      label: "// MODALIDADES DE TRABAJO",
      title: "Soluciones de Ingeniería para Escalar tu Negocio",
      subtitle:
        "Software robusto y de alto rendimiento diseñado para resolver cuellos de botella reales y acelerar el crecimiento comercial.",
      card1: {
        tag: "STARTUPS & FUNDADORES",
        badge: "0 A 1 • MVP DE PRODUCCIÓN",
        title: "Desarrollo de MVPs Imparables",
        description:
          "Construye Productos Mínimos Viables validados y listos para salir a producción. Estructurados con Clean Architecture y acelerados con IA para lanzar al mercado o presentar a rondas de inversión en semanas.",
        bullets: [
          "Entrega acelerada con IA: MVPs completos en 4 a 8 semanas",
          "Clean Architecture, código modular y tipado estricto sin bugs",
          "Acompañamiento como CTO fraccional para due diligence técnico",
          "100% de propiedad intelectual y código transferido desde el Día 1",
        ],
        ctaText: "Agendar estimación de MVP",
        ctaLink: siteConfig.calendlyUrl,
      },
      card2: {
        tag: "EMPRESAS & OPERACIONES",
        badge: "1 A N • MODERNIZACIÓN & IA",
        title: "Digitalización, Automatización y Nube",
        description:
          "Migra sistemas lentos a arquitecturas web modernas de alta velocidad. Optimizamos tu infraestructura para reducir drásticamente facturas de hosting e implementamos agentes de IA para automatizar flujos clave.",
        bullets: [
          "Auditoría técnica y reducción del 40% al 70% en facturas cloud",
          "Modernización y refactorización de código y sistemas legados",
          "Agentes de IA y pipelines de datos para automatizar procesos manuales",
          "Monitoreo proactivo, observabilidad y resiliencia en producción",
        ],
        ctaText: "Cotizar optimización por WhatsApp",
        ctaLink: getWhatsAppUrl("es", "services"),
      },
    }
  : {
      label: "// ENGAGEMENT TRACKS",
      title: "Engineered Solutions to Scale Your Business",
      subtitle:
        "High-performance custom software designed to eliminate technical bottlenecks and accelerate sustainable business growth.",
      card1: {
        tag: "STARTUPS & FOUNDERS",
        badge: "0 TO 1 • PRODUCTION MVP",
        title: "Production-Ready MVPs",
        description:
          "Build robust, market-validated Minimum Viable Products ready for real users. Powered by Clean Architecture and accelerated with AI to pitch investors and onboard customers in weeks.",
        bullets: [
          "AI-accelerated development: complete MVPs shipped in 4 to 8 weeks",
          "Clean Architecture, modular design, and strictly typed code",
          "Fractional CTO advisory ready for technical due diligence",
          "100% full intellectual property and repository ownership",
        ],
        ctaText: "Book an MVP Consultation",
        ctaLink: siteConfig.calendlyUrl,
      },
      card2: {
        tag: "GROWING BUSINESSES",
        badge: "1 TO N • MODERNIZATION & AI",
        title: "Cloud Optimization & Automation",
        description:
          "Transform sluggish legacy systems into high-speed modern architectures. Slash runaway cloud hosting expenses and embed custom AI agents to automate high-friction operational workflows.",
        bullets: [
          "Cloud architecture audit cutting 40% to 70% in monthly server bills",
          "Legacy systems modernization and zero-regression refactoring",
          "Custom AI agents and pipelines automating manual tasks",
          "Production observability, health checks, and resilient APIs",
        ],
        ctaText: "Discuss operations on WhatsApp",
        ctaLink: getWhatsAppUrl("en", "services"),
      },
    };
---

<section
  id="services"
  class="relative py-20 md:py-28 bg-base-100 overflow-hidden border-b border-stone-500/10"
>
  <!-- Background Blueprint Glow -->
  <div
    class="absolute top-1/3 left-1/3 w-96 h-96 bg-secondary/[0.03] blur-[160px] rounded-full pointer-events-none"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span
        class="text-xs font-mono font-bold tracking-widest text-secondary uppercase mb-3 block"
      >
        {content.label}
      </span>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-primary tracking-tight mb-4 font-sans"
      >
        {content.title}
      </h2>
      <p class="text-stone-400 text-base sm:text-lg leading-relaxed font-sans font-normal">
        {content.subtitle}
      </p>
    </div>

    <!-- Grid Layout for Services -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10 items-stretch">
      <!-- Card 1: Startups / MVPs -->
      <div
        class="card-premium rounded-2xl p-7 sm:p-9 flex flex-col justify-between group hover:border-secondary/40"
      >
        <div>
          <!-- Tag & Icon Header -->
          <div class="flex items-center justify-between mb-6">
            <div class="flex flex-col gap-1">
              <span
                class="text-[11px] font-bold tracking-widest text-stone-400 font-mono uppercase"
              >
                {content.card1.tag}
              </span>
              <span class="text-[10px] font-mono text-secondary tracking-wider font-semibold">
                {content.card1.badge}
              </span>
            </div>
            <div
              class="p-2.5 rounded-xl bg-base-100 border border-stone-500/20 text-secondary group-hover:border-secondary/40 transition-colors"
            >
              <Rocket class="w-6 h-6" stroke-width="1.5" />
            </div>
          </div>

          <!-- Card Header Title -->
          <h3 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight mb-4 font-sans">
            {content.card1.title}
          </h3>

          <!-- Card Description -->
          <p
            class="text-stone-300 text-sm sm:text-base leading-relaxed mb-6 font-sans"
          >
            {content.card1.description}
          </p>

          <!-- Bullet Points -->
          <ul class="space-y-3.5 mb-8">
            {
              content.card1.bullets.map((bullet) => (
                <li class="flex items-start gap-3">
                  <Check
                    class="w-4 h-4 text-secondary shrink-0 mt-1"
                    stroke-width="2"
                  />
                  <span class="text-stone-300 text-sm leading-relaxed">
                    {bullet}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Primary CTA: Calendly Booking -->
        <a
          href={content.card1.ctaLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-[#E6DFD3] text-[#141414] font-extrabold w-full rounded-xl glow-sandstone hover:bg-[#F0EAE0] hover:scale-[1.01] active:scale-[0.98] transition-all duration-300 py-4 h-auto min-h-13"
        >
          <Calendar class="w-4 h-4 text-[#141414]" stroke-width="2" />
          <span>{content.card1.ctaText}</span>
          <ArrowUpRight class="w-4 h-4 text-[#141414]/70" stroke-width="2" />
        </a>
      </div>

      <!-- Card 2: Mid-sized Companies / Cloud & AI -->
      <div
        class="card-premium rounded-2xl p-7 sm:p-9 flex flex-col justify-between group hover:border-secondary/40"
      >
        <div>
          <!-- Tag & Icon Header -->
          <div class="flex items-center justify-between mb-6">
            <div class="flex flex-col gap-1">
              <span
                class="text-[11px] font-bold tracking-widest text-stone-400 font-mono uppercase"
              >
                {content.card2.tag}
              </span>
              <span class="text-[10px] font-mono text-secondary tracking-wider font-semibold">
                {content.card2.badge}
              </span>
            </div>
            <div
              class="p-2.5 rounded-xl bg-base-100 border border-stone-500/20 text-secondary group-hover:border-secondary/40 transition-colors"
            >
              <Cpu class="w-6 h-6" stroke-width="1.5" />
            </div>
          </div>

          <!-- Card Header Title -->
          <h3 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight mb-4 font-sans">
            {content.card2.title}
          </h3>

          <!-- Card Description -->
          <p
            class="text-stone-300 text-sm sm:text-base leading-relaxed mb-6 font-sans"
          >
            {content.card2.description}
          </p>

          <!-- Bullet Points -->
          <ul class="space-y-3.5 mb-8">
            {
              content.card2.bullets.map((bullet) => (
                <li class="flex items-start gap-3">
                  <Check
                    class="w-4 h-4 text-secondary shrink-0 mt-1"
                    stroke-width="2"
                  />
                  <span class="text-stone-300 text-sm leading-relaxed">
                    {bullet}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Secondary CTA: WhatsApp Chat -->
        <a
          href={content.card2.ctaLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-base-100/90 border border-stone-500/25 text-[#F5F5F4] hover:bg-stone-500/15 hover:border-stone-400/40 font-semibold w-full rounded-xl hover:scale-[1.01] active:scale-[0.98] transition-all duration-300 py-4 h-auto min-h-13"
        >
          <MessageSquare class="w-4 h-4 text-secondary" stroke-width="2" />
          <span>{content.card2.ctaText}</span>
        </a>
      </div>
    </div>
  </div>
</section>
