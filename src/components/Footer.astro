---
const { pathname } = Astro.url;

// Normalize pathname by removing trailing slash (except for empty/root)
const cleanPathname = pathname.replace(/\/$/, "");

// Detect if current language is Spanish
const isEs = cleanPathname.startsWith("/es/") || cleanPathname === "/es";

// Translations dictionary
const slogan = isEs 
  ? "Proveyendo soluciones tecnológicas confiables desde 2012." 
  : "Providing reliable tech solutions since 2012.";

const menuTitle = isEs ? "Navegación" : "Navigation";
const menuLinks = isEs
  ? [
      { name: "Inicio", href: "/es" },
      { name: "Servicios", href: "/es/services" },
      { name: "Casos de Éxito", href: "/es/cases" },
      { name: "Blog", href: "/es/blog" },
    ]
  : [
      { name: "Home", href: "/" },
      { name: "Services", href: "/services" },
      { name: "Cases", href: "/cases" },
      { name: "Blog", href: "/blog" },
    ];

const socialTitle = isEs ? "Contacto & Redes" : "Connect & Contact";
const copyright = isEs
  ? `© ${new Date().getFullYear()} Coins5. Todos los derechos reservados.`
  : `© ${new Date().getFullYear()} Coins5. All rights reserved.`;

const byline = isEs
  ? "Diseñado e implementado con criterio senior & IA."
  : "Designed and built with senior criteria & AI.";
---

<footer class="bg-base-100 border-t border-stone-500/10 py-12 text-base-content">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-8">
      
      <!-- Column 1: Brand & Slogan -->
      <div class="md:col-span-5 flex flex-col items-start gap-4">
        <a 
          href={isEs ? "/es" : "/"} 
          class="flex items-center gap-2.5 hover:opacity-90 transition-opacity"
          aria-label="Coins5 Home"
        >
          <!-- Reduced & stylized geometric MC Isotype -->
          <svg class="h-6 w-6 text-primary" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M6 24V8H8L13 17L18 8H20V24H18V12L13 21L8 12V24H6Z" fill="currentColor" />
            <path d="M22 8H28V10H24V22H28V24H22V8Z" fill="currentColor" />
          </svg>
          <span class="text-primary font-bold tracking-tight text-lg font-sans">Coins5</span>
        </a>
        <p class="text-stone-300 text-sm max-w-sm leading-relaxed">
          {slogan}
        </p>
      </div>
      
      <!-- Column 2: Navigation Links -->
      <div class="md:col-span-3 flex flex-col items-start">
        <h6 class="text-xs font-mono tracking-wider uppercase text-stone-400 mb-4">{menuTitle}</h6>
        <ul class="flex flex-col gap-2.5">
          {menuLinks.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-stone-300 hover:text-secondary transition-colors text-sm font-medium"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Column 3: Contact & Professional Links -->
      <div class="md:col-span-4 flex flex-col items-start">
        <h6 class="text-xs font-mono tracking-wider uppercase text-stone-400 mb-4">{socialTitle}</h6>
        
        <div class="flex flex-col gap-3.5 w-full">
          <!-- Social Icons (LinkedIn, GitHub) -->
          <div class="flex items-center gap-4">
            <a 
              href="https://linkedin.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-stone-300 hover:text-secondary transition-colors" 
              aria-label="LinkedIn"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>
            <a 
              href="https://github.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-stone-300 hover:text-secondary transition-colors" 
              aria-label="GitHub"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.138 20.162 22 16.418 22 12c0-5.523-4.478-10-10-10z"/>
              </svg>
            </a>
          </div>
          
          <!-- Conversion-focused Direct Links -->
          <div class="flex flex-col gap-2.5 mt-1">
            <!-- WhatsApp (Secondary CTA) -->
            <a 
              href="https://wa.me/51900000000" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 text-stone-300 hover:text-secondary transition-colors text-sm group"
            >
              <svg class="h-4.5 w-4.5 text-stone-400 group-hover:text-secondary transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.665.989 3.3 1.489 5.358 1.49 5.487 0 9.954-4.468 9.957-9.957.001-2.659-1.033-5.16-2.91-7.039C17.18 1.768 14.675.733 12.007.733c-5.49 0-9.96 4.47-9.963 9.96-.001 2.03.498 3.654 1.48 5.32l-.988 3.613 3.71-.973zm12.33-6.945c-.272-.136-1.61-.794-1.86-.885-.25-.091-.432-.136-.613.136-.18.273-.699.885-.857 1.068-.158.182-.317.205-.589.068-.272-.136-1.15-.424-2.19-1.353-.809-.722-1.356-1.615-1.515-1.887-.159-.272-.017-.42.119-.556.122-.122.272-.318.408-.477.136-.159.182-.272.272-.454.091-.182.045-.341-.023-.477-.068-.136-.613-1.477-.84-2.022-.222-.534-.486-.46-.668-.47l-.57-.01c-.198 0-.52.074-.792.372-.272.295-1.043 1.022-1.043 2.498 0 1.477 1.073 2.908 1.22 3.102.148.193 2.113 3.227 5.118 4.524.714.309 1.272.493 1.707.632.718.228 1.37.196 1.887.119.576-.087 1.61-.659 1.837-1.295.228-.636.228-1.181.159-1.295-.068-.113-.25-.182-.522-.318z"/>
              </svg>
              <span>{isEs ? "Contactar por WhatsApp" : "Contact via WhatsApp"}</span>
            </a>
            
            <!-- Calendly (Primary CTA) -->
            <a 
              href="https://calendly.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 text-stone-300 hover:text-secondary transition-colors text-sm group"
            >
              <svg class="h-4.5 w-4.5 text-stone-400 group-hover:text-secondary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>{isEs ? "Agendar llamada de 15 min" : "Book a 15-minute call"}</span>
            </a>

            <!-- Email (Contact) -->
            <a 
              href="mailto:marlon@coins5.dev" 
              class="inline-flex items-center gap-2 text-stone-300 hover:text-secondary transition-colors text-sm group"
            >
              <svg class="h-4.5 w-4.5 text-stone-400 group-hover:text-secondary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>marlon@coins5.dev</span>
            </a>
          </div>
        </div>
      </div>
      
    </div>
    
    <!-- Divider and Bottom Copyright & Tech Byline -->
    <div class="border-t border-stone-500/10 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-stone-400">
      <p class="text-center md:text-left">
        {copyright}
      </p>
      <p class="text-center md:text-right font-mono text-[10px] tracking-tight text-stone-500">
        {byline}
      </p>
    </div>
    
  </div>
</footer>
