---
import {
  Layers,
  Zap,
  TrendingDown,
  UserCheck,
  ShieldCheck,
  Cpu,
  Check,
  Terminal,
  Server,
  Code2,
} from "@lucide/astro";

const { pathname } = Astro.url;
const cleanPathname = pathname.replace(/\/$/, "");
const isEs = cleanPathname.startsWith("/es/") || cleanPathname === "/es";

const content = isEs
  ? {
      label: "// EL MULTIPLICADOR DE VALOR",
      title: "El Factor Senior + IA: Velocidad sin Deuda Técnica",
      subtitle:
        "Por qué fundadores y líderes de negocio eligen construir directamente con un arquitecto senior en lugar de lidiar con agencias infladas o código frágil.",
      card1: {
        tag: "ARQUITECTURA ROBUSTA × IA",
        title: "Clean Architecture: Código que escala desde el Día 1",
        desc: "No generamos código desechable. Anclamos cada proyecto en principios SOLID y arquitectura desacoplada para que la aceleración con IA produzca software libre de bugs que soporte 10,000 usuarios sin refactorizaciones traumáticas.",
        layerDomain: "Capa de Dominio Puro",
        layerDomainDesc: "Lógica de negocio aislada y testeable",
        layerApp: "Orquestación & Casos de Uso",
        layerAppDesc: "Flujos de aplicación y contratos estrictos",
        layerInfra: "Infraestructura & Adaptadores IA",
        layerInfraDesc: "Postgres, APIs de LLM y Edge Workers",
        stat1: "Entrega 3x más rápida",
        stat2: "0% Deuda técnica",
      },
      card2: {
        tag: "EFICIENCIA EN COSTOS",
        title: "-60% en Costos de Nube por Diseño",
        desc: "Optimizamos tu infraestructura desde el primer commit. Servidores bien dimensionados (Dokploy/Docker), caché en capas y edge computing para evitar facturas abusivas de AWS.",
        comparisonTraditional: "Setup tradicional de agencia",
        costTraditional: "$1,200+/mes",
        comparisonCoins5: "Arquitectura optimizada Coins5",
        costCoins5: "<$60/mes",
        proofNote: "Strategio operó con <$50/mes en su fase de tracción inicial.",
      },
      card3: {
        tag: "COMUNICACIÓN DIRECTA",
        title: "Trato Directo con el Arquitecto",
        desc: "Cero intermediarios. Cero desarrolladores junior aprendiendo a costa de tu presupuesto. Cada decisión técnica es evaluada con más de 10 años de experiencia real.",
        item1: "Canal directo por WhatsApp y reuniones ágiles",
        item2: "100% de propiedad del código y repositorios",
        item3: "Feedback continuo y demos semanales funcionales",
      },
      card4: {
        tag: "VALIDACIÓN COMERCIAL",
        title: "Código Listo para Rondas de Inversión y Escala",
        desc: "Construimos software pensado para superar la auditoría técnica de inversores (due diligence) y facilitar la incorporación futura de tu propio equipo interno de ingenieros.",
        badge1: "Tipado Estricto de Extremo a Extremo",
        badge2: "Seguridad y Aislamiento Multi-Tenant",
        badge3: "Pipelines Automatizados de CI/CD",
        badge4: "Modularidad para Microservicios Futuros",
      },
    }
  : {
      label: "// THE VALUE MULTIPLIER",
      title: "The Senior + AI Advantage: Speed Without Debt",
      subtitle:
        "Why ambitious founders and business leaders build directly with a software architect instead of managing bloated agencies or fragile code.",
      card1: {
        tag: "ROBUST ARCHITECTURE × AI",
        title: "Clean Architecture: Software Built to Scale from Day 1",
        desc: "We don't write disposable vibe code. Every project is anchored in SOLID principles and decoupled design so AI acceleration produces bulletproof, test-covered code that handles enterprise growth without painful rewrites.",
        layerDomain: "Pure Domain Core",
        layerDomainDesc: "Isolated, highly testable business rules",
        layerApp: "Application & Use Cases",
        layerAppDesc: "Orchestration & strict API contracts",
        layerInfra: "Infrastructure & AI Adapters",
        layerInfraDesc: "Postgres, LLM APIs, and Edge Workers",
        stat1: "Up to 3x Faster Delivery",
        stat2: "0% Technical Debt",
      },
      card2: {
        tag: "COST EFFICIENCY",
        title: "-60% Cloud Overhead by Design",
        desc: "We optimize infrastructure from the first commit. Lean container deployments (Dokploy/Docker), multi-tier caching, and edge computing to eliminate runaway AWS bills.",
        comparisonTraditional: "Traditional agency setup",
        costTraditional: "$1,200+/mo",
        comparisonCoins5: "Coins5 engineered architecture",
        costCoins5: "<$60/mo",
        proofNote: "Strategio ran under $50/mo during its initial traction phase.",
      },
      card3: {
        tag: "DIRECT PARTNERSHIP",
        title: "Direct Access to a Senior Architect",
        desc: "Zero project managers playing telephone. Zero junior hires practicing on your budget. Every schema decision and system boundary is vetted with 12+ years of production experience.",
        item1: "Direct WhatsApp communication & agile syncs",
        item2: "100% full intellectual property & code ownership",
        item3: "Continuous feedback & weekly working demos",
      },
      card4: {
        tag: "COMMERCIAL READINESS",
        title: "Audit-Ready Code for Investor Due Diligence",
        desc: "Architected to pass technical due diligence from angel investors and make future in-house engineering team onboarding frictionless.",
        badge1: "End-to-End Strict Typing",
        badge2: "Multi-Tenant Security & Isolation",
        badge3: "Automated CI/CD Testing Pipelines",
        badge4: "Modular Boundaries for Future Microservices",
      },
    };
---

<section
  id="advantage"
  class="relative py-20 md:py-28 bg-base-100 overflow-hidden border-b border-stone-500/10"
>
  <!-- Background Ambient Glow -->
  <div
    class="absolute top-1/2 right-1/4 -translate-y-1/2 w-96 h-96 bg-secondary/[0.03] blur-[150px] rounded-full pointer-events-none"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span
        class="text-xs font-mono font-bold tracking-widest text-secondary uppercase mb-3 block"
      >
        {content.label}
      </span>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-primary tracking-tight mb-5 font-sans"
      >
        {content.title}
      </h2>
      <p class="text-stone-400 text-base sm:text-lg leading-relaxed font-sans font-normal">
        {content.subtitle}
      </p>
    </div>

    <!-- Gapless Bento Grid 2.0 (12-column layout) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      <!-- Card 1: Clean Architecture & AI Speed (Col Span 7) -->
      <div
        class="lg:col-span-7 card-premium rounded-2xl p-6 sm:p-8 flex flex-col justify-between group"
      >
        <div>
          <div class="flex items-center justify-between mb-5">
            <span
              class="text-[11px] font-mono tracking-widest text-secondary uppercase font-semibold"
            >
              {content.card1.tag}
            </span>
            <div
              class="p-2 rounded-lg bg-base-100 border border-stone-500/20 text-secondary group-hover:border-secondary/40 transition-colors"
            >
              <Layers class="w-5 h-5" stroke-width="1.5" />
            </div>
          </div>

          <h3
            class="text-2xl sm:text-3xl font-bold text-primary tracking-tight mb-4 font-sans"
          >
            {content.card1.title}
          </h3>

          <p class="text-stone-300 text-sm sm:text-base leading-relaxed mb-6 font-sans">
            {content.card1.desc}
          </p>

          <!-- Interactive Architectural Stack Blueprint Widget -->
          <div class="space-y-2.5 mb-6 p-4 rounded-xl bg-base-100/70 border border-stone-500/15 font-mono text-xs">
            <div class="flex items-center justify-between p-2 rounded-lg bg-base-200/90 border border-stone-500/20">
              <div class="flex items-center gap-2 text-stone-200 font-bold">
                <Code2 class="w-4 h-4 text-secondary" stroke-width="2" />
                <span>{content.card1.layerDomain}</span>
              </div>
              <span class="text-[10px] text-stone-400 hidden sm:inline">
                {content.card1.layerDomainDesc}
              </span>
            </div>

            <div class="flex items-center justify-between p-2 rounded-lg bg-base-200/60 border border-stone-500/15">
              <div class="flex items-center gap-2 text-stone-300">
                <Cpu class="w-4 h-4 text-stone-400" stroke-width="2" />
                <span>{content.card1.layerApp}</span>
              </div>
              <span class="text-[10px] text-stone-400 hidden sm:inline">
                {content.card1.layerAppDesc}
              </span>
            </div>

            <div class="flex items-center justify-between p-2 rounded-lg bg-base-200/40 border border-stone-500/10">
              <div class="flex items-center gap-2 text-stone-400">
                <Server class="w-4 h-4 text-stone-500" stroke-width="2" />
                <span>{content.card1.layerInfra}</span>
              </div>
              <span class="text-[10px] text-stone-400 hidden sm:inline">
                {content.card1.layerInfraDesc}
              </span>
            </div>
          </div>
        </div>

        <!-- Metric Badges Row -->
        <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-stone-500/10 font-mono text-xs">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-secondary/10 border border-secondary/20 text-secondary font-bold">
            <Zap class="w-3.5 h-3.5" stroke-width="2" />
            {content.card1.stat1}
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-stone-800/80 border border-stone-700/50 text-stone-300">
            <ShieldCheck class="w-3.5 h-3.5 text-emerald-400" stroke-width="2" />
            {content.card1.stat2}
          </span>
        </div>
      </div>

      <!-- Card 2: Infrastructure Cost Slasher (Col Span 5) -->
      <div
        class="lg:col-span-5 card-premium rounded-2xl p-6 sm:p-8 flex flex-col justify-between group"
      >
        <div>
          <div class="flex items-center justify-between mb-5">
            <span
              class="text-[11px] font-mono tracking-widest text-secondary uppercase font-semibold"
            >
              {content.card2.tag}
            </span>
            <div
              class="p-2 rounded-lg bg-base-100 border border-stone-500/20 text-secondary group-hover:border-secondary/40 transition-colors"
            >
              <TrendingDown class="w-5 h-5" stroke-width="1.5" />
            </div>
          </div>

          <h3
            class="text-2xl font-bold text-primary tracking-tight mb-4 font-sans"
          >
            {content.card2.title}
          </h3>

          <p class="text-stone-300 text-sm leading-relaxed mb-6 font-sans">
            {content.card2.desc}
          </p>

          <!-- Cost Comparison Box -->
          <div class="space-y-3 mb-6 p-4 rounded-xl bg-base-100/70 border border-stone-500/15">
            <div class="flex items-center justify-between text-xs font-mono">
              <span class="text-stone-400">{content.card2.comparisonTraditional}</span>
              <span class="text-rose-400 font-bold line-through decoration-rose-500/50">
                {content.card2.costTraditional}
              </span>
            </div>
            <div class="h-1.5 w-full bg-stone-800 rounded-full overflow-hidden">
              <div class="h-full bg-rose-500/40 w-full rounded-full"></div>
            </div>

            <div class="flex items-center justify-between text-xs font-mono pt-2">
              <span class="text-[#F5F5F4] font-semibold">{content.card2.comparisonCoins5}</span>
              <span class="text-secondary font-extrabold text-sm">
                {content.card2.costCoins5}
              </span>
            </div>
            <div class="h-1.5 w-full bg-stone-800 rounded-full overflow-hidden">
              <div class="h-full bg-secondary w-1/5 rounded-full"></div>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-stone-500/10">
          <p class="text-xs font-mono text-stone-400 flex items-center gap-2">
            <Terminal class="w-3.5 h-3.5 text-secondary shrink-0" stroke-width="2" />
            <span>{content.card2.proofNote}</span>
          </p>
        </div>
      </div>

      <!-- Card 3: Direct Senior Partnership (Col Span 5) -->
      <div
        class="lg:col-span-5 card-premium rounded-2xl p-6 sm:p-8 flex flex-col justify-between group"
      >
        <div>
          <div class="flex items-center justify-between mb-5">
            <span
              class="text-[11px] font-mono tracking-widest text-secondary uppercase font-semibold"
            >
              {content.card3.tag}
            </span>
            <div
              class="p-2 rounded-lg bg-base-100 border border-stone-500/20 text-secondary group-hover:border-secondary/40 transition-colors"
            >
              <UserCheck class="w-5 h-5" stroke-width="1.5" />
            </div>
          </div>

          <h3
            class="text-2xl font-bold text-primary tracking-tight mb-4 font-sans"
          >
            {content.card3.title}
          </h3>

          <p class="text-stone-300 text-sm leading-relaxed mb-6 font-sans">
            {content.card3.desc}
          </p>

          <!-- Direct Communication List -->
          <ul class="space-y-3 mb-6">
            <li class="flex items-start gap-2.5 text-xs font-mono text-stone-300">
              <Check class="w-4 h-4 text-secondary shrink-0 mt-0.5" stroke-width="2" />
              <span>{content.card3.item1}</span>
            </li>
            <li class="flex items-start gap-2.5 text-xs font-mono text-stone-300">
              <Check class="w-4 h-4 text-secondary shrink-0 mt-0.5" stroke-width="2" />
              <span>{content.card3.item2}</span>
            </li>
            <li class="flex items-start gap-2.5 text-xs font-mono text-stone-300">
              <Check class="w-4 h-4 text-secondary shrink-0 mt-0.5" stroke-width="2" />
              <span>{content.card3.item3}</span>
            </li>
          </ul>
        </div>

        <div class="pt-4 border-t border-stone-500/10">
          <span class="inline-block text-[11px] font-mono text-secondary uppercase font-bold tracking-wider">
            100% Criterio Senior • 0% Bloat
          </span>
        </div>
      </div>

      <!-- Card 4: Audit-Ready Code & Scalability (Col Span 7) -->
      <div
        class="lg:col-span-7 card-premium rounded-2xl p-6 sm:p-8 flex flex-col justify-between group"
      >
        <div>
          <div class="flex items-center justify-between mb-5">
            <span
              class="text-[11px] font-mono tracking-widest text-secondary uppercase font-semibold"
            >
              {content.card4.tag}
            </span>
            <div
              class="p-2 rounded-lg bg-base-100 border border-stone-500/20 text-secondary group-hover:border-secondary/40 transition-colors"
            >
              <ShieldCheck class="w-5 h-5" stroke-width="1.5" />
            </div>
          </div>

          <h3
            class="text-2xl sm:text-3xl font-bold text-primary tracking-tight mb-4 font-sans"
          >
            {content.card4.title}
          </h3>

          <p class="text-stone-300 text-sm sm:text-base leading-relaxed mb-6 font-sans">
            {content.card4.desc}
          </p>

          <!-- Badges Grid for Investor Due Diligence -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
            <div class="p-3 rounded-lg bg-base-100/60 border border-stone-500/15 flex items-center gap-2.5 text-xs font-mono text-stone-200">
              <div class="w-2 h-2 rounded-full bg-secondary shrink-0"></div>
              <span>{content.card4.badge1}</span>
            </div>
            <div class="p-3 rounded-lg bg-base-100/60 border border-stone-500/15 flex items-center gap-2.5 text-xs font-mono text-stone-200">
              <div class="w-2 h-2 rounded-full bg-secondary shrink-0"></div>
              <span>{content.card4.badge2}</span>
            </div>
            <div class="p-3 rounded-lg bg-base-100/60 border border-stone-500/15 flex items-center gap-2.5 text-xs font-mono text-stone-200">
              <div class="w-2 h-2 rounded-full bg-secondary shrink-0"></div>
              <span>{content.card4.badge3}</span>
            </div>
            <div class="p-3 rounded-lg bg-base-100/60 border border-stone-500/15 flex items-center gap-2.5 text-xs font-mono text-stone-200">
              <div class="w-2 h-2 rounded-full bg-secondary shrink-0"></div>
              <span>{content.card4.badge4}</span>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-stone-500/10 flex items-center justify-between text-xs font-mono text-stone-400">
          <span>Enterprise-Grade Patterns</span>
          <span class="text-secondary font-bold">SOLID & Clean Architecture</span>
        </div>
      </div>
    </div>
  </div>
</section>
