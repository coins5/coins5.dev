---
import { Rocket, Cpu, Check, Calendar, MessageSquare, ArrowUpRight } from "@lucide/astro";
import { getServicesContent } from "./services.content";

const { pathname } = Astro.url;
const cleanPathname = pathname.replace(/\/$/, "");
const isEs = cleanPathname.startsWith("/es/") || cleanPathname === "/es";

const content = getServicesContent(isEs);
---

<section
  id="services"
  class="relative py-20 md:py-28 bg-base-100 overflow-hidden border-b border-stone-500/10 transition-colors duration-300"
>
  <!-- Background Blueprint Glow -->
  <div
    class="absolute top-1/3 left-1/3 w-96 h-96 rounded-full pointer-events-none blur-[160px]"
    style="background-color: var(--ambient-glow);"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span
        class="text-xs font-mono font-bold tracking-widest text-secondary uppercase mb-3 block"
      >
        {content.label}
      </span>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-primary tracking-tight mb-4 font-sans"
      >
        {content.title}
      </h2>
      <p
        class="text-base sm:text-lg leading-relaxed font-sans font-normal transition-colors"
        style="color: var(--color-text-body);"
      >
        {content.subtitle}
      </p>
    </div>

    <!-- Grid Layout for Services -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10 items-stretch">
      <!-- Card 1: Startups / MVPs -->
      <div
        class="card-premium rounded-2xl p-7 sm:p-9 flex flex-col justify-between group"
      >
        <div>
          <!-- Tag & Icon Header -->
          <div class="flex items-center justify-between mb-6">
            <div class="flex flex-col gap-1">
              <span
                class="text-[11px] font-bold tracking-widest font-mono uppercase"
                style="color: var(--color-text-body);"
              >
                {content.card1.tag}
              </span>
              <span class="text-[10px] font-mono text-secondary tracking-wider font-semibold">
                {content.card1.badge}
              </span>
            </div>
            <div
              class="p-2.5 rounded-xl bg-base-100 border text-secondary group-hover:border-secondary/40 transition-colors"
              style="border-color: var(--card-border);"
            >
              <Rocket class="w-6 h-6" stroke-width="1.5" />
            </div>
          </div>

          <!-- Card Header Title -->
          <h3 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight mb-4 font-sans">
            {content.card1.title}
          </h3>

          <!-- Card Description -->
          <p
            class="text-sm sm:text-base leading-relaxed mb-6 font-sans transition-colors"
            style="color: var(--color-text-body);"
          >
            {content.card1.description}
          </p>

          <!-- Bullet Points -->
          <ul class="space-y-3.5 mb-8">
            {
              content.card1.bullets.map((bullet) => (
                <li class="flex items-start gap-3">
                  <Check
                    class="w-4 h-4 text-secondary shrink-0 mt-1"
                    stroke-width="2"
                  />
                  <span
                    class="text-sm leading-relaxed transition-colors"
                    style="color: var(--color-text-body);"
                  >
                    {bullet}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Primary CTA: Calendly Booking -->
        <a
          href={content.card1.ctaLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 font-extrabold w-full rounded-xl glow-sandstone hover:scale-[1.01] active:scale-[0.98] transition-all duration-300 py-4 h-auto min-h-13 shadow-md cursor-pointer"
          style="background-color: var(--cta-primary-bg); color: var(--cta-primary-text);"
        >
          <Calendar class="w-4 h-4" stroke-width="2" style="color: var(--cta-primary-text);" />
          <span>{content.card1.ctaText}</span>
          <ArrowUpRight class="w-4 h-4 opacity-80" stroke-width="2" style="color: var(--cta-primary-text);" />
        </a>
      </div>

      <!-- Card 2: Mid-sized Companies / Cloud & AI -->
      <div
        class="card-premium rounded-2xl p-7 sm:p-9 flex flex-col justify-between group"
      >
        <div>
          <!-- Tag & Icon Header -->
          <div class="flex items-center justify-between mb-6">
            <div class="flex flex-col gap-1">
              <span
                class="text-[11px] font-bold tracking-widest font-mono uppercase"
                style="color: var(--color-text-body);"
              >
                {content.card2.tag}
              </span>
              <span class="text-[10px] font-mono text-secondary tracking-wider font-semibold">
                {content.card2.badge}
              </span>
            </div>
            <div
              class="p-2.5 rounded-xl bg-base-100 border text-secondary group-hover:border-secondary/40 transition-colors"
              style="border-color: var(--card-border);"
            >
              <Cpu class="w-6 h-6" stroke-width="1.5" />
            </div>
          </div>

          <!-- Card Header Title -->
          <h3 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight mb-4 font-sans">
            {content.card2.title}
          </h3>

          <!-- Card Description -->
          <p
            class="text-sm sm:text-base leading-relaxed mb-6 font-sans transition-colors"
            style="color: var(--color-text-body);"
          >
            {content.card2.description}
          </p>

          <!-- Bullet Points -->
          <ul class="space-y-3.5 mb-8">
            {
              content.card2.bullets.map((bullet) => (
                <li class="flex items-start gap-3">
                  <Check
                    class="w-4 h-4 text-secondary shrink-0 mt-1"
                    stroke-width="2"
                  />
                  <span
                    class="text-sm leading-relaxed transition-colors"
                    style="color: var(--color-text-body);"
                  >
                    {bullet}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Secondary CTA: WhatsApp Chat -->
        <a
          href={content.card2.ctaLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 font-semibold w-full rounded-xl hover:scale-[1.01] active:scale-[0.98] transition-all duration-300 py-4 h-auto min-h-13 shadow-sm cursor-pointer"
          style="background-color: var(--cta-secondary-bg); color: var(--cta-secondary-text); border: 1px solid var(--cta-secondary-border);"
        >
          <MessageSquare class="w-4 h-4 text-secondary" stroke-width="2" />
          <span>{content.card2.ctaText}</span>
        </a>
      </div>
    </div>
  </div>
</section>
