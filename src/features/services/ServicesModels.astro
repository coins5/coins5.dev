---
import { Check, Calendar, ArrowRight, Sparkles } from "@lucide/astro";
import { getServicesModelsContent } from "./models.content";
import { siteConfig } from "../../config";

const { pathname } = Astro.url;
const cleanPathname = pathname.replace(/\/$/, "");
const isEs = cleanPathname.startsWith("/es/") || cleanPathname === "/es";

const models = getServicesModelsContent(isEs);
---

<section
  class="relative bg-base-100 py-16 md:py-24 border-b border-stone-500/10 transition-colors duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-mono font-bold tracking-widest text-secondary uppercase mb-3 block">
        {models.label}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight mb-4 font-sans">
        {models.title}
      </h2>
      <p
        class="text-base sm:text-lg leading-relaxed font-sans transition-colors"
        style="color: var(--color-text-body);"
      >
        {models.subtitle}
      </p>
    </div>

    <!-- Tiers Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {
        models.tiers.map((tier) => (
          <div
            class={`card-premium rounded-2xl p-7 sm:p-8 flex flex-col justify-between relative transition-all duration-300 ${
              tier.featured ? "ring-1 ring-secondary/40 shadow-xl" : ""
            }`}
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-[11px] font-mono tracking-widest text-secondary font-bold uppercase">
                  {tier.tag}
                </span>
                {tier.featured && (
                  <span
                    class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold"
                    style="background-color: var(--badge-bg); border: 1px solid var(--badge-border); color: var(--badge-text);"
                  >
                    <Sparkles class="w-3 h-3 text-secondary" stroke-width="2" />
                    {isEs ? "Más Solicitado" : "Most Popular"}
                  </span>
                )}
              </div>

              <h3 class="text-2xl font-bold text-primary mb-2 font-sans tracking-tight">
                {tier.title}
              </h3>

              <div
                class="inline-block text-xs font-mono px-3 py-1 rounded-md mb-5 font-semibold"
                style="background-color: var(--badge-bg); border: 1px solid var(--badge-border); color: var(--badge-text);"
              >
                {tier.timeline}
              </div>

              <p
                class="text-sm leading-relaxed mb-6 font-sans transition-colors"
                style="color: var(--color-text-body);"
              >
                {tier.idealFor}
              </p>

              <!-- Deliverables Checklist -->
              <div class="pt-5 border-t space-y-3 mb-8" style="border-color: var(--card-border);">
                <span
                  class="block text-[11px] font-mono uppercase tracking-widest font-semibold opacity-70 mb-3"
                  style="color: var(--color-text-body);"
                >
                  {isEs ? "Entregables Clave" : "Key Deliverables"}
                </span>
                {tier.deliverables.map((item) => (
                  <div class="flex items-start gap-2.5 text-xs font-sans">
                    <Check class="w-4 h-4 text-secondary shrink-0 mt-0.5" stroke-width="2" />
                    <span style="color: var(--color-text-body);">{item}</span>
                  </div>
                ))}
              </div>
            </div>

            <div>
              <a
                href={siteConfig.calendlyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={`btn btn-sm w-full py-2.5 h-auto rounded-lg font-bold transition-all hover:scale-[1.02] active:scale-[0.98] border-none flex items-center justify-center gap-2 ${
                  tier.featured ? "shadow-md" : ""
                }`}
                style="background-color: var(--cta-primary-bg); color: var(--cta-primary-text);"
              >
                <Calendar class="w-4 h-4" stroke-width="2" />
                <span>{isEs ? "Agendar Descubrimiento" : "Book Discovery Call"}</span>
                <ArrowRight class="w-4 h-4" stroke-width="2" />
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
