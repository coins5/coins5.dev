---
import { Search, Server, Zap, ShieldCheck } from "@lucide/astro";
import { getServicesPageContent } from "./services-page.content";

const { pathname } = Astro.url;
const cleanPathname = pathname.replace(/\/$/, "");
const isEs = cleanPathname.startsWith("/es/") || cleanPathname === "/es";

const { process } = getServicesPageContent(isEs);
const icons = [Search, Server, Zap, ShieldCheck];
---

<section
  class="relative bg-base-200 py-16 md:py-24 border-b border-stone-500/10 transition-colors duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight mb-4 font-sans">
        {process.title}
      </h2>
      <p
        class="text-base sm:text-lg leading-relaxed font-sans transition-colors"
        style="color: var(--color-text-body);"
      >
        {process.subtitle}
      </p>
    </div>

    <!-- Process Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {
        process.steps.map((item, index) => {
          const IconComponent = icons[index];
          return (
            <div class="card-premium rounded-2xl p-6 flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between mb-5">
                  <span class="font-mono text-xs text-secondary font-bold tracking-widest uppercase">
                    {item.step}
                  </span>
                  <div
                    class="w-8 h-8 rounded-lg bg-base-100 border flex items-center justify-center text-secondary group-hover:border-secondary/40 transition-colors"
                    style="border-color: var(--card-border);"
                  >
                    <IconComponent class="w-4 h-4" stroke-width="1.5" />
                  </div>
                </div>

                <h3 class="text-xl font-bold text-primary tracking-tight mb-3 font-sans">
                  {item.title}
                </h3>

                <p
                  class="text-sm leading-relaxed font-sans transition-colors"
                  style="color: var(--color-text-body);"
                >
                  {item.desc}
                </p>
              </div>

              <div
                class="mt-6 pt-4 border-t text-[11px] font-mono text-secondary font-medium"
                style="border-color: var(--card-border);"
              >
                Sprint Gate 0{index + 1}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
