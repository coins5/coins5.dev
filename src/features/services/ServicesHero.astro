---
import { getServicesPageContent } from "./services-page.content";

const { pathname } = Astro.url;
const cleanPathname = pathname.replace(/\/$/, "");
const isEs = cleanPathname.startsWith("/es/") || cleanPathname === "/es";

const content = getServicesPageContent(isEs).hero;
---

<section
  class="relative bg-base-100 py-20 lg:py-28 overflow-hidden border-b border-stone-500/10 transition-colors duration-300"
>
  <!-- Architectural Blueprint Grid Backdrop -->
  <div
    class="absolute inset-0 bg-[linear-gradient(to_right,var(--blueprint-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--blueprint-line)_1px,transparent_1px)] bg-[size:32px_32px] mask-[radial-gradient(ellipse_70%_60%_at_50%_20%,#000_60%,transparent_100%)] pointer-events-none"
  >
  </div>

  <!-- Warm Sandstone Ambient Glow -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[32rem] h-[16rem] rounded-full pointer-events-none blur-[140px]"
    style="background-color: var(--ambient-glow);"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10">
    <div
      class="inline-flex items-center gap-2 px-3.5 py-1.5 mb-6 rounded-full backdrop-blur-md shadow-xs transition-all"
      style="background-color: var(--pill-bg); border: 1px solid var(--pill-border);"
    >
      <span class="text-xs font-mono font-bold tracking-widest text-secondary uppercase">
        {content.pill}
      </span>
    </div>

    <!-- H1 2-line Rule -->
    <h1
      class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-primary tracking-tight mb-6 max-w-4xl mx-auto leading-[1.1] font-sans"
    >
      {content.title}
    </h1>

    <p
      class="text-base sm:text-lg lg:text-xl max-w-3xl mx-auto leading-relaxed font-sans font-normal transition-colors"
      style="color: var(--color-text-body);"
    >
      {content.subtitle}
    </p>
  </div>
</section>
