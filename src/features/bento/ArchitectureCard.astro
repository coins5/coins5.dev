---
import { Layers, Zap, ShieldCheck, Cpu, Server, Code2 } from "@lucide/astro";

interface Props {
  card: {
    tag: string;
    title: string;
    desc: string;
    layerDomain: string;
    layerDomainDesc: string;
    layerApp: string;
    layerAppDesc: string;
    layerInfra: string;
    layerInfraDesc: string;
    stat1: string;
    stat2: string;
  };
}

const { card } = Astro.props;
---

<div class="lg:col-span-7 card-premium rounded-2xl p-6 sm:p-8 flex flex-col justify-between group">
  <div>
    <div class="flex items-center justify-between mb-5">
      <span class="text-[11px] font-mono tracking-widest text-secondary uppercase font-semibold">
        {card.tag}
      </span>
      <div
        class="p-2 rounded-lg bg-base-100 border text-secondary group-hover:border-secondary/40 transition-colors"
        style="border-color: var(--card-border);"
      >
        <Layers class="w-5 h-5" stroke-width="1.5" />
      </div>
    </div>

    <h3 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight mb-4 font-sans">
      {card.title}
    </h3>

    <p
      class="text-sm sm:text-base leading-relaxed mb-6 font-sans transition-colors"
      style="color: var(--color-text-body);"
    >
      {card.desc}
    </p>

    <!-- Interactive Architectural Stack Blueprint Widget -->
    <div
      class="space-y-2.5 mb-6 p-4 rounded-xl border font-mono text-xs transition-colors"
      style="background-color: var(--card-inner-bg); border-color: var(--card-border);"
    >
      <div
        class="flex items-center justify-between p-2.5 rounded-lg border shadow-xs"
        style="background-color: var(--card-bg); border-color: var(--card-border);"
      >
        <div class="flex items-center gap-2 text-primary font-bold">
          <Code2 class="w-4 h-4 text-secondary" stroke-width="2" />
          <span>{card.layerDomain}</span>
        </div>
        <span class="text-[10px] hidden sm:inline opacity-70" style="color: var(--color-text-body);">
          {card.layerDomainDesc}
        </span>
      </div>

      <div
        class="flex items-center justify-between p-2.5 rounded-lg border shadow-xs opacity-90"
        style="background-color: var(--card-bg); border-color: var(--card-border);"
      >
        <div class="flex items-center gap-2 text-primary font-medium">
          <Cpu class="w-4 h-4 text-secondary" stroke-width="2" />
          <span>{card.layerApp}</span>
        </div>
        <span class="text-[10px] hidden sm:inline opacity-70" style="color: var(--color-text-body);">
          {card.layerAppDesc}
        </span>
      </div>

      <div
        class="flex items-center justify-between p-2.5 rounded-lg border shadow-xs opacity-80"
        style="background-color: var(--card-bg); border-color: var(--card-border);"
      >
        <div class="flex items-center gap-2 text-primary font-medium">
          <Server class="w-4 h-4 opacity-70" stroke-width="2" />
          <span>{card.layerInfra}</span>
        </div>
        <span class="text-[10px] hidden sm:inline opacity-70" style="color: var(--color-text-body);">
          {card.layerInfraDesc}
        </span>
      </div>
    </div>
  </div>

  <!-- Metric Badges Row -->
  <div
    class="flex flex-wrap items-center gap-3 pt-4 border-t font-mono text-xs"
    style="border-color: var(--card-border);"
  >
    <span
      class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md font-bold"
      style="background-color: var(--badge-bg); border: 1px solid var(--badge-border); color: var(--badge-text);"
    >
      <Zap class="w-3.5 h-3.5" stroke-width="2" />
      {card.stat1}
    </span>
    <span
      class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md"
      style="background-color: var(--badge-bg); border: 1px solid var(--badge-border); color: var(--badge-text);"
    >
      <ShieldCheck class="w-3.5 h-3.5 text-emerald-500" stroke-width="2" />
      {card.stat2}
    </span>
  </div>
</div>
