---
import { UserCheck, Check } from "@lucide/astro";

interface Props {
  card: {
    tag: string;
    title: string;
    desc: string;
    item1: string;
    item2: string;
    item3: string;
  };
}

const { card } = Astro.props;
---

<div class="lg:col-span-5 card-premium rounded-2xl p-6 sm:p-8 flex flex-col justify-between group">
  <div>
    <div class="flex items-center justify-between mb-5">
      <span class="text-[11px] font-mono tracking-widest text-secondary uppercase font-semibold">
        {card.tag}
      </span>
      <div
        class="p-2 rounded-lg bg-base-100 border text-secondary group-hover:border-secondary/40 transition-colors"
        style="border-color: var(--card-border);"
      >
        <UserCheck class="w-5 h-5" stroke-width="1.5" />
      </div>
    </div>

    <h3 class="text-2xl font-bold text-primary tracking-tight mb-4 font-sans">
      {card.title}
    </h3>

    <p
      class="text-sm leading-relaxed mb-6 font-sans transition-colors"
      style="color: var(--color-text-body);"
    >
      {card.desc}
    </p>

    <!-- Direct Communication List -->
    <ul class="space-y-3 mb-6 font-sans text-xs">
      <li class="flex items-start gap-2.5">
        <Check class="w-4 h-4 text-secondary shrink-0 mt-0.5" stroke-width="2" />
        <span style="color: var(--color-text-body);">{card.item1}</span>
      </li>
      <li class="flex items-start gap-2.5">
        <Check class="w-4 h-4 text-secondary shrink-0 mt-0.5" stroke-width="2" />
        <span style="color: var(--color-text-body);">{card.item2}</span>
      </li>
      <li class="flex items-start gap-2.5">
        <Check class="w-4 h-4 text-secondary shrink-0 mt-0.5" stroke-width="2" />
        <span style="color: var(--color-text-body);">{card.item3}</span>
      </li>
    </ul>
  </div>

  <div class="pt-4 border-t" style="border-color: var(--card-border);">
    <span class="inline-block text-[11px] font-mono text-secondary uppercase font-bold tracking-wider">
      100% Criterio Senior • 0% Bloat
    </span>
  </div>
</div>
