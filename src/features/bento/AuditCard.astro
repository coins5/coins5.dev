---
import { ShieldCheck } from "@lucide/astro";

interface Props {
  card: {
    tag: string;
    title: string;
    desc: string;
    badge1: string;
    badge2: string;
    badge3: string;
    badge4: string;
  };
}

const { card } = Astro.props;
---

<div class="lg:col-span-7 card-premium rounded-2xl p-6 sm:p-8 flex flex-col justify-between group">
  <div>
    <div class="flex items-center justify-between mb-5">
      <span class="text-[11px] font-mono tracking-widest text-secondary uppercase font-semibold">
        {card.tag}
      </span>
      <div
        class="p-2 rounded-lg bg-base-100 border text-secondary group-hover:border-secondary/40 transition-colors"
        style="border-color: var(--card-border);"
      >
        <ShieldCheck class="w-5 h-5" stroke-width="1.5" />
      </div>
    </div>

    <h3 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight mb-4 font-sans">
      {card.title}
    </h3>

    <p
      class="text-sm sm:text-base leading-relaxed mb-6 font-sans transition-colors"
      style="color: var(--color-text-body);"
    >
      {card.desc}
    </p>

    <!-- Badges Grid for Investor Due Diligence -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
      <div
        class="p-3 rounded-lg border flex items-center gap-2.5 text-xs font-mono"
        style="background-color: var(--card-inner-bg); border-color: var(--card-border); color: var(--color-heading);"
      >
        <div class="w-2 h-2 rounded-full bg-secondary shrink-0"></div>
        <span>{card.badge1}</span>
      </div>
      <div
        class="p-3 rounded-lg border flex items-center gap-2.5 text-xs font-mono"
        style="background-color: var(--card-inner-bg); border-color: var(--card-border); color: var(--color-heading);"
      >
        <div class="w-2 h-2 rounded-full bg-secondary shrink-0"></div>
        <span>{card.badge2}</span>
      </div>
      <div
        class="p-3 rounded-lg border flex items-center gap-2.5 text-xs font-mono"
        style="background-color: var(--card-inner-bg); border-color: var(--card-border); color: var(--color-heading);"
      >
        <div class="w-2 h-2 rounded-full bg-secondary shrink-0"></div>
        <span>{card.badge3}</span>
      </div>
      <div
        class="p-3 rounded-lg border flex items-center gap-2.5 text-xs font-mono"
        style="background-color: var(--card-inner-bg); border-color: var(--card-border); color: var(--color-heading);"
      >
        <div class="w-2 h-2 rounded-full bg-secondary shrink-0"></div>
        <span>{card.badge4}</span>
      </div>
    </div>
  </div>

  <div
    class="pt-4 border-t flex items-center justify-between text-xs font-mono"
    style="border-color: var(--card-border); color: var(--color-text-body);"
  >
    <span>Enterprise-Grade Patterns</span>
    <span class="text-secondary font-bold">SOLID & Clean Architecture</span>
  </div>
</div>
