---
import { Calendar, Tag, ArrowRight } from "@lucide/astro";

interface Props {
  entry: any;
  isEs?: boolean;
}

const { entry, isEs = false } = Astro.props;

const slug =
  entry.id
    .split("/")
    .pop()
    ?.replace(/\.(md|mdx)$/, "") || entry.id;

const formattedDate = entry.data.pubDate.toLocaleDateString(
  isEs ? "es-PE" : "en-US",
  {
    year: "numeric",
    month: "short",
    day: "numeric",
  }
);

const blogUrl = isEs ? `/es/blog/${slug}` : `/blog/${slug}`;
---

<a
  href={blogUrl}
  class="group card-premium rounded-2xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300"
>
  <div>
    <div
      class="flex items-center text-xs font-mono mb-4 gap-1.5 opacity-75"
      style="color: var(--color-text-body);"
    >
      <Calendar class="w-3.5 h-3.5 text-secondary" stroke-width="2" />
      <span>{formattedDate}</span>
    </div>

    <h3 class="text-xl font-bold text-primary mb-3 group-hover:text-secondary transition-colors line-clamp-2 font-sans tracking-tight">
      {entry.data.title}
    </h3>

    <p
      class="text-sm leading-relaxed mb-6 line-clamp-3 font-sans transition-colors"
      style="color: var(--color-text-body);"
    >
      {entry.data.description}
    </p>
  </div>

  <div class="mt-auto">
    <div
      class="flex flex-wrap gap-1.5 pt-4 border-t mb-4"
      style="border-color: var(--card-border);"
    >
      {
        entry.data.tags.map((tag: string) => (
          <span
            class="inline-flex items-center gap-1 px-2 py-0.5 text-[10px] font-mono rounded"
            style="background-color: var(--tech-pill-bg); border: 1px solid var(--tech-pill-border); color: var(--tech-pill-text);"
          >
            <Tag class="w-2.5 h-2.5" stroke-width="1.5" />
            {tag}
          </span>
        ))
      }
    </div>

    <div class="flex items-center text-xs font-mono font-bold text-secondary group-hover:translate-x-1 transition-transform">
      <span>{isEs ? "Leer artículo" : "Read article"}</span>
      <ArrowRight class="w-4 h-4 ml-1.5" stroke-width="2" />
    </div>
  </div>
</a>
