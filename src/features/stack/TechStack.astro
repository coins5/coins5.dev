---
import { getStackContent } from "./stack.content";

const { pathname } = Astro.url;
const cleanPathname = pathname.replace(/\/$/, "");
const isEs = cleanPathname.startsWith("/es/") || cleanPathname === "/es";

const content = getStackContent(isEs);
---

<section
  id="stack"
  class="relative py-20 md:py-28 bg-base-100 overflow-hidden border-b border-stone-500/10 transition-colors duration-300"
>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span
        class="text-xs font-mono font-bold tracking-widest text-secondary uppercase mb-3 block"
      >
        {content.label}
      </span>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-primary tracking-tight mb-4 font-sans"
      >
        {content.title}
      </h2>
      <p
        class="text-base sm:text-lg leading-relaxed font-sans font-normal transition-colors"
        style="color: var(--color-text-body);"
      >
        {content.subtitle}
      </p>
    </div>

    <!-- Tech Stack Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {
        content.categories.map((cat) => {
          const Icon = cat.icon;
          return (
            <div class="card-premium rounded-2xl p-6 flex flex-col justify-between group">
              <div>
                <!-- Category Icon & Title -->
                <div class="flex items-center gap-3 mb-4">
                  <div
                    class="p-2 rounded-lg bg-base-100 border text-secondary group-hover:border-secondary/40 transition-colors"
                    style="border-color: var(--card-border);"
                  >
                    <Icon class="w-5 h-5" stroke-width="1.5" />
                  </div>
                  <h3 class="text-lg font-bold text-primary font-sans">
                    {cat.title}
                  </h3>
                </div>

                <p
                  class="text-xs leading-relaxed mb-6 font-sans font-normal transition-colors"
                  style="color: var(--color-text-body);"
                >
                  {cat.desc}
                </p>
              </div>

              <!-- Tech Pills -->
              <div
                class="flex flex-col gap-2 pt-4 border-t"
                style="border-color: var(--card-border);"
              >
                {cat.items.map((item) => (
                  <div
                    class="flex items-center justify-between px-3 py-1.5 rounded-lg border transition-colors"
                    style="background-color: var(--tech-pill-bg); border-color: var(--tech-pill-border);"
                  >
                    <span
                      class="text-xs font-mono font-medium"
                      style="color: var(--tech-pill-text);"
                    >
                      {item}
                    </span>
                    <span class="w-1.5 h-1.5 rounded-full bg-secondary/80"></span>
                  </div>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
