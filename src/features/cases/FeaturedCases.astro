---
import { ArrowUpRight, ExternalLink } from "@lucide/astro";
import { getCasesContent } from "./cases.content";

const { pathname } = Astro.url;
const cleanPathname = pathname.replace(/\/$/, "");
const isEs = cleanPathname.startsWith("/es/") || cleanPathname === "/es";

const content = getCasesContent(isEs);
---

<section
  id="cases"
  class="relative py-20 md:py-28 bg-base-100 overflow-hidden border-b border-stone-500/10 transition-colors duration-300"
>
  <!-- Architectural ambient background -->
  <div
    class="absolute bottom-10 left-1/4 w-80 h-80 rounded-full pointer-events-none blur-[140px]"
    style="background-color: var(--ambient-glow);"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl">
        <span
          class="text-xs font-mono font-bold tracking-widest text-secondary uppercase mb-3 block"
        >
          {content.label}
        </span>
        <h2
          class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-primary tracking-tight font-sans"
        >
          {content.title}
        </h2>
        <p
          class="text-base sm:text-lg leading-relaxed mt-4 font-sans font-normal transition-colors"
          style="color: var(--color-text-body);"
        >
          {content.subtitle}
        </p>
      </div>

      <a
        href={content.allCasesUrl}
        class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-wider uppercase text-secondary hover:underline transition-colors shrink-0 group self-start md:self-end"
      >
        <span>{content.viewAll}</span>
        <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" stroke-width="2" />
      </a>
    </div>

    <!-- Case Studies 3-Column Showcase Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
      {
        content.cases.map((project) => {
          const Icon = project.icon;
          return (
            <div class="card-premium rounded-2xl p-6 sm:p-8 flex flex-col justify-between group">
              <div>
                <!-- Top Badge & Icon -->
                <div class="flex items-center justify-between mb-5">
                  <span
                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider"
                    style="background-color: var(--badge-bg); border: 1px solid var(--badge-border); color: var(--badge-text);"
                  >
                    {project.badge}
                  </span>
                  <div
                    class="p-2 rounded-lg bg-base-100 border text-secondary group-hover:border-secondary/40 transition-colors"
                    style="border-color: var(--card-border);"
                  >
                    <Icon class="w-4 h-4" stroke-width="1.5" />
                  </div>
                </div>

                <!-- Title & Role -->
                <h3 class="text-xl sm:text-2xl font-bold text-primary tracking-tight mb-2 font-sans group-hover:text-secondary transition-colors">
                  {project.title}
                </h3>
                <span
                  class="block text-xs font-mono mb-4 transition-colors"
                  style="color: var(--color-text-body);"
                >
                  {project.role}
                </span>

                <!-- High-Impact Outcome Callout -->
                <div
                  class="p-3.5 rounded-xl border mb-5 transition-colors"
                  style="background-color: var(--card-inner-bg); border-color: var(--card-border);"
                >
                  <span class="text-xs font-mono text-emerald-600 dark:text-emerald-400 font-bold block leading-relaxed">
                    ✓ {project.outcome}
                  </span>
                </div>

                <!-- Description -->
                <p
                  class="text-sm leading-relaxed mb-6 font-sans transition-colors"
                  style="color: var(--color-text-body);"
                >
                  {project.desc}
                </p>
              </div>

              <div>
                <!-- Tech Stack Pills -->
                <div
                  class="flex flex-wrap gap-1.5 mb-6 pt-4 border-t"
                  style="border-color: var(--card-border);"
                >
                  {project.technologies.map((tech) => (
                    <span
                      class="px-2 py-0.5 rounded text-[11px] font-mono transition-colors"
                      style="background-color: var(--tech-pill-bg); border: 1px solid var(--tech-pill-border); color: var(--tech-pill-text);"
                    >
                      {tech}
                    </span>
                  ))}
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-between pt-2">
                  <a
                    href={project.slug}
                    class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-secondary hover:underline transition-colors group/link"
                  >
                    <span>{content.viewCase}</span>
                    <ArrowUpRight class="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5" stroke-width="2" />
                  </a>

                  {project.externalUrl && (
                    <a
                      href={project.externalUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-[11px] font-mono hover:underline transition-colors opacity-70 hover:opacity-100"
                      style="color: var(--color-text-body);"
                      aria-label={`Visit ${project.title} website`}
                    >
                      <ExternalLink class="w-3 h-3" stroke-width="2" />
                      <span>Live Site</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
