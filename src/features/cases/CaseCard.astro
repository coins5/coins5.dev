---
import { ArrowRight } from "@lucide/astro";

interface Props {
  entry: any;
  isEs?: boolean;
}

const { entry, isEs = false } = Astro.props;

const slug =
  entry.id
    .split("/")
    .pop()
    ?.replace(/\.(md|mdx)$/, "") || entry.id;

const caseUrl = isEs ? `/es/cases/${slug}` : `/cases/${slug}`;
---

<a
  href={caseUrl}
  data-case-slug={slug}
  data-case-client={entry.data.clientName ? entry.data.clientName.toLowerCase() : ""}
  data-case-techs={entry.data.technologies ? entry.data.technologies.join(",").toLowerCase() : ""}
  class="group card-premium rounded-2xl p-7 sm:p-8 flex flex-col justify-between transition-all duration-300"
>
  <div>
    <!-- Massive Impact Metric Highlight -->
    <div
      class="mb-6 pb-6 border-b flex items-center justify-between"
      style="border-color: var(--card-border);"
    >
      <div>
        <span
          class="block text-[11px] font-mono uppercase tracking-widest mb-1.5 opacity-70"
          style="color: var(--color-text-body);"
        >
          {isEs ? "Impacto Clave / ROI" : "Key Impact / ROI"}
        </span>
        <div class="text-2xl sm:text-3xl font-extrabold font-mono text-secondary tracking-tight">
          {entry.data.impactMetric}
        </div>
      </div>
      <span
        class="text-xs font-mono px-3 py-1 rounded-md font-semibold"
        style="background-color: var(--badge-bg); border: 1px solid var(--badge-border); color: var(--badge-text);"
      >
        {entry.data.clientName}
      </span>
    </div>

    <!-- Title & Description -->
    <div class="mb-5">
      <h3 class="text-xl sm:text-2xl font-bold text-primary group-hover:text-secondary transition-colors leading-tight font-sans mb-3">
        {entry.data.title}
      </h3>
      <p
        class="text-sm leading-relaxed font-sans transition-colors"
        style="color: var(--color-text-body);"
      >
        {entry.data.description}
      </p>
    </div>
  </div>

  <div class="mt-4 pt-5 border-t" style="border-color: var(--card-border);">
    {
      entry.data.technologies && entry.data.technologies.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mb-5">
          {entry.data.technologies.map((tech: string) => (
            <span
              class="px-2.5 py-1 text-[11px] font-mono rounded"
              style="background-color: var(--tech-pill-bg); border: 1px solid var(--tech-pill-border); color: var(--tech-pill-text);"
            >
              {tech}
            </span>
          ))}
        </div>
      )
    }

    <div class="flex items-center text-xs font-mono font-bold text-secondary group-hover:translate-x-1 transition-transform">
      <span>{isEs ? "Ver Caso de Estudio" : "View Case Study"}</span>
      <ArrowRight class="w-4 h-4 ml-2" stroke-width="2" />
    </div>
  </div>
</a>
