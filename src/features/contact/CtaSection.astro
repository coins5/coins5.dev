---
import { Calendar, MessageSquare, ArrowUpRight, CheckCircle2 } from "@lucide/astro";
import { siteConfig } from "../../config";
import { getCtaContent } from "./cta.content";

const { pathname } = Astro.url;
const cleanPathname = pathname.replace(/\/$/, "");
const isEs = cleanPathname.startsWith("/es/") || cleanPathname === "/es";

const content = getCtaContent(isEs);
---

<section
  id="contact"
  class="relative py-20 md:py-32 bg-base-100 overflow-hidden transition-colors duration-300"
>
  <!-- Ambient Glow in Sandstone -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[38rem] h-[22rem] rounded-full pointer-events-none blur-[160px]"
    style="background-color: var(--ambient-glow);"
  >
  </div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
    <div
      class="card-premium rounded-3xl p-8 sm:p-12 md:p-16 text-center glow-sandstone"
    >
      <!-- Section Label -->
      <span
        class="text-xs font-mono font-bold tracking-widest text-secondary uppercase mb-4 block"
      >
        {content.label}
      </span>

      <!-- Imposing H2 Title -->
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-primary tracking-tight max-w-3xl mx-auto mb-6 font-sans leading-[1.12]"
      >
        {content.title}
      </h2>

      <!-- Subtitle -->
      <p
        class="text-base sm:text-lg max-w-2xl mx-auto leading-relaxed mb-10 font-sans font-normal transition-colors"
        style="color: var(--color-text-body);"
      >
        {content.subtitle}
      </p>

      <!-- Conversion Actions Hub -->
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-12 max-w-xl mx-auto"
      >
        <!-- Primary CTA: Calendly Booking -->
        <a
          href={siteConfig.calendlyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 font-extrabold px-8 py-4 h-auto min-h-14 rounded-xl w-full sm:w-auto glow-sandstone hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 text-sm sm:text-base shadow-md cursor-pointer"
          style="background-color: var(--cta-primary-bg); color: var(--cta-primary-text);"
        >
          <Calendar class="w-5 h-5" stroke-width="2" style="color: var(--cta-primary-text);" />
          <span>{content.primaryCta}</span>
          <ArrowUpRight class="w-4 h-4 opacity-80" stroke-width="2" style="color: var(--cta-primary-text);" />
        </a>

        <!-- Secondary CTA: WhatsApp Chat -->
        <a
          href={content.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 font-semibold px-8 py-4 h-auto min-h-14 rounded-xl w-full sm:w-auto hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 text-sm sm:text-base shadow-sm cursor-pointer"
          style="background-color: var(--cta-secondary-bg); color: var(--cta-secondary-text); border: 1px solid var(--cta-secondary-border);"
        >
          <MessageSquare class="w-5 h-5 text-secondary" stroke-width="2" />
          <span>{content.secondaryCta}</span>
        </a>
      </div>

      <!-- Trust Factors Strip -->
      <div
        class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 pt-8 border-t text-xs font-mono"
        style="border-color: var(--card-border); color: var(--color-text-body);"
      >
        <span class="inline-flex items-center gap-2">
          <CheckCircle2 class="w-4 h-4 text-secondary shrink-0" stroke-width="2" />
          {content.trust1}
        </span>
        <span class="inline-flex items-center gap-2">
          <CheckCircle2 class="w-4 h-4 text-secondary shrink-0" stroke-width="2" />
          {content.trust2}
        </span>
        <span class="inline-flex items-center gap-2">
          <CheckCircle2 class="w-4 h-4 text-secondary shrink-0" stroke-width="2" />
          {content.trust3}
        </span>
      </div>

      <!-- Direct Email Fallback -->
      <div
        class="mt-6 text-xs font-mono transition-colors"
        style="color: var(--color-text-body);"
      >
        <span>{content.directEmail} </span>
        <a
          href={`mailto:${siteConfig.email}`}
          class="text-secondary hover:underline ml-1 font-bold"
        >
          {siteConfig.email}
        </a>
      </div>
    </div>
  </div>
</section>
