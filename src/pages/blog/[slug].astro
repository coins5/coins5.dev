---
import { getCollection, render } from "astro:content";
import { ArrowLeft, Calendar, Tag } from "@lucide/astro";
import { Image } from "astro:assets";
import marlonImage from "../../assets/marlon.png";
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../config";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");

  // Filter for English articles strictly
  const enEntries = blogEntries.filter((entry) => entry.data.lang === "en");

  return enEntries.map((entry) => {
    const slug =
      entry.id
        .split("/")
        .pop()
        ?.replace(/\.(md|mdx)$/, "") || entry.id;
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Format date nicely
const formattedDate = entry.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  title={`${entry.data.title} | Coins5`}
  description={entry.data.description}
  lang="en"
  keywords={entry.data.keywords}
  ogImage={entry.data.ogImage}
  ogType="article"
>
  <div class="relative py-12 md:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb & Back button -->
    <a
      href="/blog"
      class="inline-flex items-center text-xs font-mono font-bold text-secondary mb-8 transition-colors group"
    >
      <ArrowLeft
        class="w-4 h-4 mr-2 transition-transform group-hover:-translate-x-1"
        stroke-width="2"
      />
      Back to Blog
    </a>

    <header class="mb-10 pb-8 border-b" style="border-color: var(--card-border);">
      <!-- Tags -->
      {
        entry.data.tags && entry.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-4">
            {entry.data.tags.map((tag: string) => (
              <span
                class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-mono rounded"
                style="background-color: var(--tech-pill-bg); border: 1px solid var(--tech-pill-border); color: var(--tech-pill-text);"
              >
                <Tag class="w-3 h-3" stroke-width="1.5" />
                {tag}
              </span>
            ))}
          </div>
        )
      }

      <h1
        class="text-3xl md:text-5xl font-extrabold text-primary tracking-tight leading-tight mb-4 font-sans"
      >
        {entry.data.title}
      </h1>

      <div
        class="flex items-center text-xs font-mono opacity-75"
        style="color: var(--color-text-body);"
      >
        <Calendar class="w-3.5 h-3.5 text-secondary mr-1.5" stroke-width="2" />
        <time datetime={entry.data.pubDate.toISOString()}>
          {formattedDate}
        </time>
        <span class="mx-3 opacity-40">&bull;</span>
        <span>Written by Marlon</span>
      </div>
    </header>

    <!-- Premium Reading Layout using Adaptive Typography -->
    <article class="prose max-w-none transition-colors">
      <Content />
    </article>

    <!-- Author Bio & Engineering Advisory Card -->
    <div class="mt-16 pt-10 border-t" style="border-color: var(--card-border);">
      <div class="card-premium rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-6 shadow-xl">
        <Image
          src={marlonImage}
          alt="Marlon - Senior Architect"
          width={160}
          height={160}
          class="w-20 h-20 rounded-full border-2 object-cover shrink-0"
          style="border-color: var(--card-border);"
        />
        <div class="flex-1 text-center sm:text-left">
          <div class="text-xs font-mono text-secondary uppercase tracking-widest font-semibold mb-1">
            Author & Systems Architect
          </div>
          <h3 class="text-lg font-bold text-primary mb-2 font-sans">
            Marlon / Coins5
          </h3>
          <p
            class="text-xs sm:text-sm leading-relaxed mb-4 font-sans transition-colors"
            style="color: var(--color-text-body);"
          >
            Senior Full Stack Developer & Cloud Architect. Building custom software and production MVPs with Clean Architecture, high-concurrency cloud design, and AI velocity.
          </p>
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4">
            <a
              href={siteConfig.calendlyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-xs px-4 py-2 h-auto rounded-lg font-bold border-none transition-all hover:scale-[1.02]"
              style="background-color: var(--cta-primary-bg); color: var(--cta-primary-text);"
            >
              Book 15-Min Discovery
            </a>
            <a
              href="/blog"
              class="text-xs font-mono text-secondary hover:text-primary transition-colors flex items-center gap-1 font-semibold"
            >
              View all articles &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
