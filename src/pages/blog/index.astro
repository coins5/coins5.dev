---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const blogEntries = await getCollection('blog');
const enEntries = blogEntries
  .filter(entry => entry.data.lang === 'en' && !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Our Blog | Coins5"
  description="Insights on custom software development, MVP building, cloud optimization, and AI integration for startups."
  lang="en"
>
  <div class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="text-xs font-mono text-secondary uppercase tracking-widest">Engineering Insights</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-primary tracking-tight mt-2 mb-4">
        The Coins5 Blog
      </h1>
      <p class="text-stone-400 text-lg">
        Practical guides, architectural strategies, and expert advice on building scalable systems and leveraging AI.
      </p>
    </div>

    {enEntries.length === 0 ? (
      <div class="text-center py-12 text-stone-500 font-mono">
        No articles published yet. Stay tuned!
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {enEntries.map(entry => {
          const slug = entry.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') || entry.id;
          const formattedDate = entry.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });
          
          return (
            <a 
              href={`/blog/${slug}`}
              class="group block bg-base-200 border border-stone-850 hover:border-stone-500/30 rounded-xl p-6 transition-all duration-300 shadow-md flex flex-col justify-between h-full hover:shadow-lg hover:shadow-stone-950/20"
            >
              <div>
                <div class="flex justify-between items-center text-xs font-mono text-stone-500 mb-4">
                  <span>{formattedDate}</span>
                </div>
                
                <h3 class="text-xl font-bold text-primary mb-3 group-hover:text-secondary transition-colors line-clamp-2">
                  {entry.data.title}
                </h3>
                
                <p class="text-stone-400 text-sm leading-relaxed mb-6 line-clamp-3">
                  {entry.data.description}
                </p>
              </div>
              
              <div>
                {entry.data.tags && entry.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 pt-4 border-t border-stone-800/40">
                    {entry.data.tags.map((tag: string) => (
                      <span class="px-2 py-0.5 text-[10px] font-mono bg-base-100 border border-stone-800/80 text-stone-400 rounded">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</Layout>
