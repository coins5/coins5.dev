---
import { getCollection, render } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const caseEntries = await getCollection('cases');
  
  // Filter for English cases strictly
  const enEntries = caseEntries.filter(entry => entry.data.lang === 'en');
  
  return enEntries.map(entry => {
    // The slug is the last segment of the file's ID (e.g. "en/strategio" -> "strategio")
    const slug = entry.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') || entry.id;
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout 
  title={`${entry.data.title} | Case Study`} 
  description={entry.data.description} 
  lang="en"
  ogType="article"
>
  <div class="py-12 md:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb & Back button -->
    <a href="/cases" class="inline-flex items-center text-sm font-mono text-secondary hover:text-stone-400 mb-8 transition-colors group">
      <ArrowLeft class="w-4 h-4 mr-2 transition-transform group-hover:-translate-x-1" stroke-width="1.5" /> Back to Case Studies
    </a>
    
    <!-- Premium Header Dashboard Container -->
    <div class="mb-12 p-6 md:p-8 bg-base-200 border border-secondary/20 rounded-xl shadow-xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Client details & Title -->
        <div class="lg:col-span-7">
          <div class="text-xs font-mono text-secondary uppercase tracking-widest mb-3">
            Client Case Study &bull; {entry.data.clientName}
          </div>
          <h1 class="text-3xl md:text-4xl font-extrabold text-primary tracking-tight leading-tight">
            {entry.data.title}
          </h1>
        </div>

        <!-- Massive Impact Metric Box -->
        <div class="lg:col-span-5">
          <div class="bg-base-100/60 border border-stone-800/80 px-6 py-6 md:py-8 rounded-lg text-center flex flex-col justify-center items-center shadow-inner">
            <span class="text-xs font-mono uppercase tracking-widest text-stone-500 mb-2">Key Impact & ROI</span>
            <div class="text-2xl md:text-3xl font-extrabold font-mono text-secondary tracking-tight">
              {entry.data.impactMetric}
            </div>
            <span class="text-[10px] font-mono text-stone-400 mt-2 uppercase tracking-wider">Verified Result</span>
          </div>
        </div>
      </div>

      <!-- Tech Stack Badges row inside header -->
      {entry.data.technologies && entry.data.technologies.length > 0 && (
        <div class="mt-6 pt-6 border-t border-stone-850 flex flex-wrap items-center gap-2">
          <span class="text-xs font-mono text-stone-500 uppercase mr-1">Stack:</span>
          {entry.data.technologies.map((tech: string) => (
            <span class="px-2.5 py-1 text-xs font-mono bg-base-100 border border-stone-800 text-stone-300 rounded-md">
              {tech}
            </span>
          ))}
        </div>
      )}
    </div>
    
    <!-- Premium Reading Layout using Tailwind Typography -->
    <article class="prose prose-stone prose-invert max-w-none 
      prose-headings:text-primary 
      prose-p:text-[#CCCCCC] prose-p:leading-relaxed prose-p:mb-6
      prose-a:text-secondary hover:prose-a:text-stone-400 prose-a:transition-colors
      prose-strong:text-primary
      prose-ul:list-disc prose-ul:pl-6 prose-ul:mb-6 prose-ul:text-stone-300
      prose-ol:list-decimal prose-ol:pl-6 prose-ol:mb-6 prose-ol:text-stone-300
      prose-li:mb-2
      prose-pre:bg-base-200 prose-pre:border prose-pre:border-stone-800/80 prose-pre:rounded-xl
      prose-code:text-secondary prose-code:bg-base-200 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-code:text-sm prose-code:before:content-none prose-code:after:content-none"
    >
      <Content />
    </article>
  </div>
</Layout>
