---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const caseEntries = await getCollection('cases');
const enEntries = caseEntries
  .filter(entry => entry.data.lang === 'en')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Our Case Studies | Coins5"
  description="Proven track record of building production-ready MVPs, cloud architectures, and AI systems."
  lang="en"
>
  <div class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="text-xs font-mono text-secondary uppercase tracking-widest">Real Results / Proof</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-primary tracking-tight mt-2 mb-4">
        Success Cases
      </h1>
      <p class="text-stone-400 text-lg">
        Discover how we design high-availability cloud solutions and AI engines that cut operational costs and scale.
      </p>
    </div>

    {enEntries.length === 0 ? (
      <div class="text-center py-12 text-stone-500 font-mono">
        No case studies published yet. Stay tuned!
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {enEntries.map(entry => {
          const slug = entry.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') || entry.id;
          
          return (
            <a 
              href={`/cases/${slug}`}
              class="group block bg-base-200 border border-stone-850 hover:border-stone-500/30 rounded-xl p-8 transition-all duration-300 shadow-md flex flex-col justify-between h-full hover:shadow-lg hover:shadow-stone-950/20"
            >
              <div>
                <div class="flex justify-between items-start mb-6">
                  <span class="text-xs font-mono text-secondary uppercase tracking-wider bg-base-100 px-3 py-1 rounded border border-stone-800">
                    {entry.data.clientName}
                  </span>
                  {entry.data.impactMetric && (
                    <span class="text-xs font-mono font-bold text-secondary bg-secondary/5 border border-secondary/20 px-2.5 py-1 rounded">
                      {entry.data.impactMetric}
                    </span>
                  )}
                </div>
                
                <h3 class="text-2xl font-bold text-primary mb-3 group-hover:text-secondary transition-colors">
                  {entry.data.title}
                </h3>
                
                <p class="text-stone-400 text-sm leading-relaxed mb-6">
                  {entry.data.description}
                </p>
              </div>
              
              <div>
                {entry.data.technologies && entry.data.technologies.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 pt-4 border-t border-stone-800/40">
                    {entry.data.technologies.map((tech: string) => (
                      <span class="px-2 py-0.5 text-[10px] font-mono bg-base-100 border border-stone-800/80 text-stone-400 rounded">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</Layout>
