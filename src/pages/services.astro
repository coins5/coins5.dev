---
import Layout from "../layouts/Layout.astro";
import {
  Search,
  Server,
  Zap,
  ShieldCheck,
  Calendar,
  MessageSquare,
} from "@lucide/astro";
import { siteConfig, getWhatsAppUrl } from "../config";

// English Services page
---

<Layout
  title="Our Services | Coins5"
  description="High-performance custom software & MVP development. We combine senior systems architecture with advanced AI tools for fast, cost-efficient delivery."
  lang="en"
>
  <!-- Hero / Header Section -->
  <section
    class="relative bg-base-100 py-20 lg:py-28 overflow-hidden border-b border-stone-500/5"
  >
    <!-- Grid Background -->
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,#80808005_1px,transparent_1px),linear-gradient(to_bottom,#80808005_1px,transparent_1px)] bg-size-[32px_32px] pointer-events-none"
    >
    </div>
    <!-- Soft Glow -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-secondary/5 blur-[120px] rounded-full pointer-events-none"
    >
    </div>

    <div
      class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10"
    >
      <span
        class="text-[11px] font-semibold tracking-widest text-secondary font-mono uppercase bg-base-200 border border-stone-500/15 px-3 py-1.5 rounded-full select-none"
      >
        B2B Software Development & MVPs
      </span>
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-primary tracking-tight mt-6 mb-6 max-w-4xl mx-auto leading-[1.1]"
      >
        Production-Ready Software Built to Adapt.
      </h1>
      <p
        class="text-text-body text-base sm:text-lg lg:text-xl max-w-3xl mx-auto leading-relaxed font-sans"
      >
        We bridge the gap between fast-paced startup timelines and strict
        enterprise architecture. Get robust, secure, and production-tested MVPs
        delivered in weeks, not months.
      </p>
    </div>
  </section>

  <!-- SECTION A: THE PROCESS -->
  <section
    class="relative bg-base-200 py-16 md:py-24 border-b border-stone-500/5"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2
          class="text-3xl sm:text-4xl font-bold text-primary tracking-tight mb-4"
        >
          From Concept to Production in Weeks, Not Months
        </h2>
        <p class="text-text-body text-base leading-relaxed">
          A streamlined engineering framework designed to maximize speed to
          market without accumulating technical debt.
        </p>
      </div>

      <!-- Process Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Step 1 -->
        <div
          class="bg-base-100 border border-stone-500/10 rounded-xl p-6 hover:border-stone-500/20 transition-all duration-300"
        >
          <div class="flex items-center justify-between mb-4">
            <span
              class="font-mono text-xs text-secondary tracking-widest uppercase"
              >01 / Scoping</span
            >
            <div
              class="w-8 h-8 rounded-lg bg-base-200 border border-stone-500/10 flex items-center justify-center text-secondary"
            >
              <Search class="w-4.5 h-4.5" stroke-width="1.5" />
            </div>
          </div>
          <h3 class="text-lg font-bold text-primary mb-2">Discovery</h3>
          <p class="text-stone-400 text-sm leading-relaxed">
            We align business objectives with technical constraints. We define a
            minimal, high-impact feature set to get your product in front of
            users fast.
          </p>
        </div>

        <!-- Step 2 -->
        <div
          class="bg-base-100 border border-stone-500/10 rounded-xl p-6 hover:border-stone-500/20 transition-all duration-300"
        >
          <div class="flex items-center justify-between mb-4">
            <span
              class="font-mono text-xs text-secondary tracking-widest uppercase"
              >02 / Design</span
            >
            <div
              class="w-8 h-8 rounded-lg bg-base-200 border border-stone-500/10 flex items-center justify-center text-secondary"
            >
              <Server class="w-4.5 h-4.5" stroke-width="1.5" />
            </div>
          </div>
          <h3 class="text-lg font-bold text-primary mb-2">
            Clean Architecture
          </h3>
          <p class="text-stone-400 text-sm leading-relaxed">
            We build with decoupled layers, SOLID principles, and clean APIs.
            This guarantees your code scales smoothly and remains easy to
            extend.
          </p>
        </div>

        <!-- Step 3 -->
        <div
          class="bg-base-100 border border-stone-500/10 rounded-xl p-6 hover:border-stone-500/20 transition-all duration-300"
        >
          <div class="flex items-center justify-between mb-4">
            <span
              class="font-mono text-xs text-secondary tracking-widest uppercase"
              >03 / Build</span
            >
            <div
              class="w-8 h-8 rounded-lg bg-base-200 border border-stone-500/10 flex items-center justify-center text-secondary"
            >
              <Zap class="w-4.5 h-4.5" stroke-width="1.5" />
            </div>
          </div>
          <h3 class="text-lg font-bold text-primary mb-2">
            AI-Accelerated Dev
          </h3>
          <p class="text-stone-400 text-sm leading-relaxed">
            We leverage advanced AI tools to automate boilerplate, write tests,
            and speed up routine coding tasks—accelerating time-to-market up to
            3x.
          </p>
        </div>

        <!-- Step 4 -->
        <div
          class="bg-base-100 border border-stone-500/10 rounded-xl p-6 hover:border-stone-500/20 transition-all duration-300"
        >
          <div class="flex items-center justify-between mb-4">
            <span
              class="font-mono text-xs text-secondary tracking-widest uppercase"
              >04 / Ship</span
            >
            <div
              class="w-8 h-8 rounded-lg bg-base-200 border border-stone-500/10 flex items-center justify-center text-secondary"
            >
              <ShieldCheck class="w-4.5 h-4.5" stroke-width="1.5" />
            </div>
          </div>
          <h3 class="text-lg font-bold text-primary mb-2">Cloud Deployment</h3>
          <p class="text-stone-400 text-sm leading-relaxed">
            We deploy to optimized, serverless architectures with robust CI/CD.
            Your application scales on-demand with near-zero infrastructure
            overhead.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION B: THE SENIOR + AI ADVANTAGE -->
  <section
    class="relative bg-base-100 py-16 md:py-24 border-b border-stone-500/5"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2
          class="text-3xl sm:text-4xl font-bold text-primary tracking-tight mb-4"
        >
          Why Software Built with AI-Assisted Senior Engineering Wins
        </h2>
        <p class="text-text-body text-base leading-relaxed">
          Traditional software agencies lock you into slow delivery, bloated
          billing, and brittle spaghetti code. Here is how we break that cycle.
        </p>
      </div>

      <!-- Technological Panel Wrapper -->
      <div
        class="border border-stone-500/10 bg-base-200/50 rounded-2xl p-6 sm:p-8 lg:p-12 shadow-xl shadow-stone-950/20 max-w-5xl mx-auto"
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
          <!-- Box 1: Dynamic Modular Boundaries -->
          <div
            class="flex flex-col justify-between p-6 rounded-xl bg-base-200 border border-stone-500/10 hover:border-secondary/20 transition-all duration-300 group"
          >
            <div>
              <div class="flex items-center gap-2 mb-4">
                <span
                  class="font-mono text-[10px] tracking-widest text-secondary bg-base-100 px-2.5 py-1 rounded border border-stone-500/15"
                >
                  SYS_AGILITY
                </span>
                <span
                  class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"
                ></span>
              </div>
              <h3
                class="font-mono text-sm tracking-wider text-primary uppercase mb-3"
              >
                01 // Dynamic Modular Boundaries
              </h3>
              <p class="text-text-body text-sm leading-relaxed">
                By enforcing clean architecture and strict separation of
                concerns, we isolate business logic from databases and UI
                frameworks.
              </p>
              <p class="text-text-body text-sm leading-relaxed mt-3">
                <strong class="text-stone-300">The Pain Solved:</strong> You will
                never be overcharged or wait weeks for simple UI adjustments or database
                swaps. Changes that take standard agencies weeks are resolved in hours.
              </p>
            </div>
          </div>

          <!-- Box 2: Infrastructure Optimization -->
          <div
            class="flex flex-col justify-between p-6 rounded-xl bg-base-200 border border-stone-500/10 hover:border-secondary/20 transition-all duration-300 group"
          >
            <div>
              <div class="flex items-center gap-2 mb-4">
                <span
                  class="font-mono text-[10px] tracking-widest text-secondary bg-base-100 px-2.5 py-1 rounded border border-stone-500/15"
                >
                  CLOUD_OPTIMIZATION
                </span>
                <span
                  class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"
                ></span>
              </div>
              <h3
                class="font-mono text-sm tracking-wider text-primary uppercase mb-3"
              >
                02 // Severe Hosting Cost Reduction
              </h3>
              <p class="text-text-body text-sm leading-relaxed">
                We design serverless deployments, utilize efficient caching
                strategies, and optimize database indexing. No idle servers
                running 24/7.
              </p>
              <p class="text-text-body text-sm leading-relaxed mt-3">
                <strong class="text-stone-300">The Pain Solved:</strong> Avoid expensive,
                oversized Virtual Machines and surprise cloud invoices. We optimize
                infrastructure so hosting starts at $0/month and scales linearly with
                actual usage.
              </p>
            </div>
          </div>

          <!-- Box 3: Automated Rigor -->
          <div
            class="flex flex-col justify-between p-6 rounded-xl bg-base-200 border border-stone-500/10 hover:border-secondary/20 transition-all duration-300 group"
          >
            <div>
              <div class="flex items-center gap-2 mb-4">
                <span
                  class="font-mono text-[10px] tracking-widest text-secondary bg-base-100 px-2.5 py-1 rounded border border-stone-500/15"
                >
                  AI_QUALITY_ASSURANCE
                </span>
                <span
                  class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"
                ></span>
              </div>
              <h3
                class="font-mono text-sm tracking-wider text-primary uppercase mb-3"
              >
                03 // AI-Assisted Testing Pipelines
              </h3>
              <p class="text-text-body text-sm leading-relaxed">
                We pair senior oversight with AI agents to write comprehensive
                end-to-end and unit test suites on every pull request
                automatically.
              </p>
              <p class="text-text-body text-sm leading-relaxed mt-3">
                <strong class="text-stone-300">The Pain Solved:</strong> We eradicate
                the typical "fix one bug, break three things" agency pattern. Your
                releases remain rock solid and regressions are blocked before they
                hit staging.
              </p>
            </div>
          </div>

          <!-- Box 4: Velocity Multiplying -->
          <div
            class="flex flex-col justify-between p-6 rounded-xl bg-base-200 border border-stone-500/10 hover:border-secondary/20 transition-all duration-300 group"
          >
            <div>
              <div class="flex items-center gap-2 mb-4">
                <span
                  class="font-mono text-[10px] tracking-widest text-secondary bg-base-100 px-2.5 py-1 rounded border border-stone-500/15"
                >
                  ENGINEERING_VELOCITY
                </span>
                <span
                  class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"
                ></span>
              </div>
              <h3
                class="font-mono text-sm tracking-wider text-primary uppercase mb-3"
              >
                04 // 3x Faster Safe Delivery
              </h3>
              <p class="text-text-body text-sm leading-relaxed">
                We don't let AI write raw software without supervision. We use
                AI as a high-speed copilot to execute boilerplate while
                maintaining total architectural control.
              </p>
              <p class="text-text-body text-sm leading-relaxed mt-3">
                <strong class="text-stone-300">The Pain Solved:</strong> Launch ahead
                of competitors. By shifting manual coding overhead to AI tools, we
                compress traditional multi-month roadmaps into single-month sprints.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION C: FINAL DEEP CTA -->
  <section
    class="relative bg-base-200 py-16 md:py-24 overflow-hidden border-b border-stone-500/5"
  >
    <!-- Grid Background -->
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,#80808003_1px,transparent_1px),linear-gradient(to_bottom,#80808003_1px,transparent_1px)] bg-size-[24px_24px] pointer-events-none"
    >
    </div>

    <div
      class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10"
    >
      <div
        class="border border-stone-500/10 bg-base-100 p-8 sm:p-12 rounded-2xl relative overflow-hidden shadow-2xl"
      >
        <!-- Glow Element inside Card -->
        <div
          class="absolute -top-12 left-1/2 -translate-x-1/2 w-72 h-72 bg-secondary/5 blur-[80px] rounded-full pointer-events-none"
        >
        </div>

        <h2
          class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight mb-4 relative z-10"
        >
          Ready to build something scalable? Let's discuss your architecture.
        </h2>
        <p
          class="text-text-body text-sm sm:text-base max-w-2xl mx-auto mb-10 relative z-10 font-sans"
        >
          No pushy sales calls. Just a 15-minute technical audit of your product
          roadmap, database structure, or cloud setup.
        </p>

        <!-- CTA Buttons -->
        <div
          class="flex flex-col sm:flex-row gap-4 justify-center items-center relative z-10 w-full sm:w-auto"
        >
          <!-- Primary: Calendly -->
          <a
            href={siteConfig.calendlyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 bg-[#E6DFD3] text-[#141414] font-extrabold px-8 py-4 h-auto min-h-14 rounded-lg w-full sm:w-auto shadow-[0_4px_20px_rgba(230,223,211,0.15)] hover:shadow-[0_6px_25px_rgba(230,223,211,0.25)] hover:bg-[#F0EAE0] hover:scale-[1.03] active:scale-[0.98] transition-all duration-300"
          >
            <Calendar class="w-5 h-5" stroke-width="2" />
            Book a 15-Min Discovery Call
          </a>

          <!-- Secondary: WhatsApp -->
          <a
            href={getWhatsAppUrl("en", "default")}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 border border-stone-500/30 text-[#F5F5F4] hover:bg-stone-500/10 hover:border-stone-500/50 px-8 py-4 h-auto min-h-14 rounded-lg w-full sm:w-auto hover:scale-[1.02] active:scale-[0.98] transition-all duration-300"
          >
            <MessageSquare class="w-5 h-5 text-secondary" stroke-width="2" />
            Discuss via WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
