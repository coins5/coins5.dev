---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import CaseCard from "../features/cases/CaseCard.astro";
import CasesFilter from "../features/cases/CasesFilter.astro";

const caseEntries = await getCollection("cases");
const enEntries = caseEntries
  .filter((entry) => entry.data.lang === "en")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Success Cases & Engineering Portfolio | Coins5"
  description="Proven track record of building production-ready MVPs, high-availability cloud architectures, and scalable AI solutions."
  lang="en"
>
  <div class="relative py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 overflow-hidden">
    <!-- Ambient Glow & Blueprint Grid -->
    <div
      class="absolute top-12 left-1/2 -translate-x-1/2 w-96 h-48 rounded-full pointer-events-none blur-[140px]"
      style="background-color: var(--ambient-glow);"
    >
    </div>

    <!-- Header Section -->
    <div class="relative max-w-3xl mx-auto text-center mb-12 z-10">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 mb-5 rounded-full backdrop-blur-md shadow-xs"
        style="background-color: var(--pill-bg); border: 1px solid var(--pill-border);"
      >
        <span class="text-xs font-mono font-bold tracking-widest text-secondary uppercase">
          Real Results & Proof
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-primary tracking-tight mb-4 font-sans">
        Success Cases
      </h1>
      <p
        class="text-base sm:text-lg leading-relaxed font-sans transition-colors"
        style="color: var(--color-text-body);"
      >
        Explore detailed engineering case studies showing how we design robust architectures, cut infrastructure costs, and deliver production value.
      </p>
    </div>

    <!-- Filter Pills Bar -->
    <div class="relative z-10">
      <CasesFilter isEs={false} />
    </div>

    {
      enEntries.length === 0 ? (
        <div
          class="relative text-center py-16 font-mono rounded-xl border border-dashed z-10"
          style="background-color: var(--card-inner-bg); border-color: var(--card-border); color: var(--color-text-body);"
        >
          No case studies published yet. Stay tuned!
        </div>
      ) : (
        <div id="cases-grid" class="relative grid grid-cols-1 md:grid-cols-2 gap-8 z-10">
          {enEntries.map((entry) => (
            <CaseCard entry={entry} isEs={false} />
          ))}
        </div>
      )
    }
  </div>
</Layout>
