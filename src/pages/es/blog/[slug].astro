---
import { getCollection, render } from "astro:content";
import { ArrowLeft, Calendar, Clock, Tag, MessageSquare } from "@lucide/astro";
import { Image } from "astro:assets";
import marlonImage from "../../../assets/marlon.png";
import Layout from "../../../layouts/Layout.astro";
import { siteConfig } from "../../../config";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");

  // Filter for Spanish articles strictly
  const esEntries = blogEntries.filter((entry) => entry.data.lang === "es");

  return esEntries.map((entry) => {
    const slug =
      entry.id
        .split("/")
        .pop()
        ?.replace(/\.(md|mdx)$/, "") || entry.id;
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);

import { getArticleSchema, getBreadcrumbSchema } from "../../../utils/seo-schemas";

// Calculate automatic reading time based on body word count (~200 WPM)
const wordCount = entry.body ? entry.body.trim().split(/\s+/).filter(Boolean).length : 0;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));
const readingTime = `${readingMinutes} min de lectura`;

// Format date nicely in Spanish (UTC ensures no local timezone shift)
const formattedDate = entry.data.pubDate.toLocaleDateString("es-PE", {
  timeZone: "UTC",
  year: "numeric",
  month: "long",
  day: "numeric",
});

const currentSlug = Astro.params.slug;
const canonicalUrl = `${siteConfig.siteUrl}/es/blog/${currentSlug}/`;
const articleSchema = [
  getArticleSchema(entry, canonicalUrl, "es"),
  getBreadcrumbSchema([
    { name: "Inicio", url: `${siteConfig.siteUrl}/es/` },
    { name: "Blog", url: `${siteConfig.siteUrl}/es/blog/` },
    { name: entry.data.title, url: canonicalUrl },
  ]),
];

const whatsappMessage = `Hola Marlon, quisiera cotizar un proyecto de software relacionado con "${entry.data.title}".`;
const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<Layout
  title={`${entry.data.title} | Coins5`}
  description={entry.data.description}
  lang="es"
  keywords={entry.data.keywords}
  ogImage={entry.data.ogImage}
  ogType="article"
  schema={articleSchema}
>
  <div class="relative py-12 md:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb & Back button -->
    <a
      href="/es/blog/"
      class="inline-flex items-center text-xs font-mono font-bold text-secondary mb-8 transition-colors group"
    >
      <ArrowLeft
        class="w-4 h-4 mr-2 transition-transform group-hover:-translate-x-1"
        stroke-width="2"
      />
      Volver al Blog
    </a>

    <header class="mb-10 pb-8 border-b" style="border-color: var(--card-border);">
      <!-- Tags -->
      {
        entry.data.tags && entry.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-4">
            {entry.data.tags.map((tag: string) => (
              <span
                class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono rounded-md select-none"
                style="background-color: var(--tech-pill-bg); border: 1px solid var(--tech-pill-border); color: var(--tech-pill-text);"
              >
                <Tag class="w-3 h-3 opacity-60" stroke-width="1.5" />
                {tag}
              </span>
            ))}
          </div>
        )
      }

      <h1
        class="text-3xl md:text-5xl font-extrabold text-primary tracking-tight leading-tight mb-4 font-sans"
      >
        {entry.data.title}
      </h1>

      <div
        class="flex flex-wrap items-center gap-y-2 text-xs font-mono"
        style="color: var(--color-text-body);"
      >
        <span class="inline-flex items-center">
          <Calendar class="w-3.5 h-3.5 text-secondary mr-1.5 shrink-0" stroke-width="2" />
          <time datetime={entry.data.pubDate.toISOString()}>
            {formattedDate}
          </time>
        </span>
        <span class="mx-3 opacity-40">&bull;</span>
        <span class="inline-flex items-center">
          <Clock class="w-3.5 h-3.5 text-secondary mr-1.5 shrink-0" stroke-width="2" />
          <span>{readingTime}</span>
        </span>
        <span class="mx-3 opacity-40">&bull;</span>
        <span>Escrito por Marlon</span>
      </div>
    </header>

    <!-- Premium Reading Layout using Adaptive Typography -->
    <article class="prose max-w-none transition-colors">
      <Content />
    </article>

    <!-- Bottom Article CTA (AIDA: Action - Scalable Conversion) -->
    <div
      class="mt-14 p-8 sm:p-10 rounded-2xl border text-center shadow-lg transition-all"
      style="background-color: var(--card-inner-bg); border-color: var(--card-border);"
    >
      <h3 class="text-2xl sm:text-3xl font-extrabold text-primary mb-3 tracking-tight font-sans">
        {entry.data.ctaTitle || "¿Listo para acelerar tu desarrollo?"}
      </h3>
      <p
        class="text-sm sm:text-base max-w-xl mx-auto mb-6 leading-relaxed font-sans"
        style="color: var(--color-text-body);"
      >
        {entry.data.ctaDescription || "Conversemos sobre tu arquitectura de software, infraestructura cloud o nuevo MVP en una llamada técnica de descubrimiento de 15 minutos."}
      </p>
      <div class="flex flex-col sm:flex-row gap-3.5 justify-center items-center">
        <a
          href={siteConfig.calendlyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-sm px-6 py-2.5 h-auto rounded-lg font-bold border-none transition-all hover:scale-[1.02] active:scale-[0.98]"
          style="background-color: var(--cta-primary-bg); color: var(--cta-primary-text);"
        >
          <Calendar class="w-4 h-4 mr-2" stroke-width="2" />
          Agendar una Reunión
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost btn-sm px-5 py-2.5 h-auto rounded-lg font-semibold border transition-all hover:border-emerald-500/40"
          style="border-color: var(--card-border); color: var(--color-text-body);"
        >
          <MessageSquare class="w-4 h-4 mr-2 text-emerald-500" stroke-width="2" />
          Cotizar por WhatsApp
        </a>
      </div>
    </div>

    <!-- Author Bio & Engineering Advisory Card -->
    <div class="mt-14 pt-10 border-t" style="border-color: var(--card-border);">
      <div class="card-premium rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-6 shadow-xl">
        <Image
          src={marlonImage}
          alt="Marlon - Senior Architect"
          width={160}
          height={160}
          class="w-20 h-20 rounded-full border-2 object-cover shrink-0"
          style="border-color: var(--card-border);"
        />
        <div class="flex-1 text-center sm:text-left">
          <div class="text-xs font-mono text-secondary uppercase tracking-widest font-semibold mb-1">
            Autor & Arquitecto de Software
          </div>
          <h3 class="text-lg font-bold text-primary mb-2 font-sans">
            Marlon / Coins5
          </h3>
          <p
            class="text-xs sm:text-sm leading-relaxed mb-4 font-sans transition-colors"
            style="color: var(--color-text-body);"
          >
            Senior Full Stack Developer & Arquitecto Cloud. Desarrollo de software a medida y MVPs robustos combinando Clean Architecture, diseño de sistemas de alta concurrencia y velocidad asistida por IA.
          </p>
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4">
            <a
              href={siteConfig.calendlyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-xs px-4 py-2 h-auto rounded-lg font-bold border-none transition-all hover:scale-[1.02]"
              style="background-color: var(--cta-primary-bg); color: var(--cta-primary-text);"
            >
              Agendar Llamada de 15 min
            </a>
            <a
              href="/es/blog/"
              class="text-xs font-mono text-secondary hover:text-primary transition-colors flex items-center gap-1 font-semibold"
            >
              Ver todos los artículos &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
