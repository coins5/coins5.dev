---
import "../../../styles/global.css";

export async function getStaticPaths() {
  return [
    { params: { slug: "initial-post" }, props: { title: "Cómo Empezar con MVPs a Medida" } }
  ];
}

const { slug } = Astro.params;
const { title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Blog de Coins5</title>
    <meta name="description" content={`Aprende sobre software a medida: ${title}`} />
  </head>
  <body>
    <main class="max-w-4xl mx-auto px-4 py-12">
      <h1 class="text-4xl font-bold text-primary mb-4">{title}</h1>
      <p class="text-stone-400 mb-8">Este es el contenedor dinámico para las entradas de blog en español: <code>{slug}</code></p>
    </main>
  </body>
</html>
