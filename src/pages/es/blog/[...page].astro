---
import type { GetStaticPaths, Page } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import BlogCard from "../../../features/blog/BlogCard.astro";
import { ChevronLeft, ChevronRight } from "@lucide/astro";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const blogEntries = await getCollection("blog");
  const filteredPosts = blogEntries
    .filter((entry) => entry.data.lang === "es" && !entry.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(filteredPosts, { pageSize: 6 });
};

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
---

<Layout
  title="Blog de Arquitectura e IA | Coins5"
  description="Artículos sobre desarrollo de software a medida, construcción de MVPs rápidos, optimización cloud y automatizaciones con IA."
  lang="es"
>
  <div class="relative py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 overflow-hidden">
    <!-- Ambient Glow & Blueprint Grid -->
    <div
      class="absolute top-12 left-1/2 -translate-x-1/2 w-96 h-48 rounded-full pointer-events-none blur-[140px]"
      style="background-color: var(--ambient-glow);"
    >
    </div>

    <!-- Header Section -->
    <div class="relative max-w-3xl mx-auto text-center mb-16 z-10">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 mb-5 rounded-full backdrop-blur-md shadow-xs"
        style="background-color: var(--pill-bg); border: 1px solid var(--pill-border);"
      >
        <span class="text-xs font-mono font-bold tracking-widest text-secondary uppercase">
          Artículos e Ingeniería
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-primary tracking-tight mb-4 font-sans">
        Artículos y Perspectivas
      </h1>
      <p
        class="text-base sm:text-lg leading-relaxed font-sans transition-colors"
        style="color: var(--color-text-body);"
      >
        Guías prácticas, criterios de arquitectura de software limpia y el uso de Inteligencia Artificial para optimizar costos y acelerar entregas.
      </p>
    </div>

    {
      page.data.length === 0 ? (
        <div
          class="relative text-center py-16 font-mono rounded-xl border border-dashed z-10"
          style="background-color: var(--card-inner-bg); border-color: var(--card-border); color: var(--color-text-body);"
        >
          Aún no hay artículos publicados. ¡Vuelve pronto!
        </div>
      ) : (
        <>
          <div class="relative grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 z-10">
            {page.data.map((entry) => (
              <BlogCard entry={entry} isEs={true} />
            ))}
          </div>

          {/* Pagination Navigation */}
          {page.lastPage > 1 && (
            <div class="flex justify-center mt-16 relative z-10">
              <div
                class="join card-premium rounded-xl overflow-hidden shadow-lg"
                style="border-color: var(--card-border);"
              >
                {page.url.prev ? (
                  <a
                    href={page.url.prev}
                    class="join-item btn btn-md bg-transparent border-y-0 border-l-0 border-r text-primary hover:text-secondary px-5 flex items-center gap-2"
                    style="border-color: var(--card-border);"
                  >
                    <ChevronLeft class="w-4 h-4" stroke-width="2" />
                    <span>Anterior</span>
                  </a>
                ) : (
                  <button
                    class="join-item btn btn-md bg-transparent border-y-0 border-l-0 border-r opacity-40 cursor-not-allowed btn-disabled px-5 flex items-center gap-2"
                    style="border-color: var(--card-border); color: var(--color-text-body);"
                    disabled
                    type="button"
                  >
                    <ChevronLeft class="w-4 h-4" stroke-width="2" />
                    <span>Anterior</span>
                  </button>
                )}

                <span
                  class="join-item px-6 flex items-center text-xs font-mono select-none border-y-0 border-l-0 border-r"
                  style="border-color: var(--card-border); color: var(--color-text-body);"
                >
                  Página {page.currentPage} de {page.lastPage}
                </span>

                {page.url.next ? (
                  <a
                    href={page.url.next}
                    class="join-item btn btn-md bg-transparent border-none text-primary hover:text-secondary px-5 flex items-center gap-2"
                  >
                    <span>Siguiente</span>
                    <ChevronRight class="w-4 h-4" stroke-width="2" />
                  </a>
                ) : (
                  <button
                    class="join-item btn btn-md bg-transparent border-none opacity-40 cursor-not-allowed btn-disabled px-5 flex items-center gap-2"
                    style="color: var(--color-text-body);"
                    disabled
                    type="button"
                  >
                    <span>Siguiente</span>
                    <ChevronRight class="w-4 h-4" stroke-width="2" />
                  </button>
                )}
              </div>
            </div>
          )}
        </>
      )
    }
  </div>
</Layout>
