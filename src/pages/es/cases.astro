---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { ArrowRight } from "@lucide/astro";

const caseEntries = await getCollection("cases");
const esEntries = caseEntries
  .filter((entry) => entry.data.lang === "es")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Casos de Éxito y Portafolio de Ingeniería | Coins5"
  description="Trayectoria comprobada en el desarrollo de MVPs escalables, arquitecturas de alta disponibilidad y soluciones de IA."
  lang="es"
>
  <div class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header Section -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="text-xs font-mono text-secondary uppercase tracking-widest bg-base-200/50 px-3 py-1.5 rounded-full border border-stone-850"
        >Resultados Reales</span
      >
      <h1
        class="text-4xl sm:text-5xl font-extrabold text-primary tracking-tight mt-4 mb-4"
      >
        Casos de Éxito
      </h1>
      <p class="text-stone-400 text-lg">
        Explora nuestros casos de estudio de ingeniería que demuestran cómo diseñamos arquitecturas robustas, reducimos costos en la nube y aportamos valor comercial.
      </p>
    </div>

    {
      esEntries.length === 0 ? (
        <div class="text-center py-16 text-stone-500 font-mono bg-base-200/30 rounded-xl border border-stone-900 border-dashed">
          Aún no hay casos de estudio publicados.
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {esEntries.map((entry) => {
            const slug =
              entry.id
                .split("/")
                .pop()
                ?.replace(/\.(md|mdx)$/, "") || entry.id;

            return (
              <a
                href={`/es/cases/${slug}`}
                class="group flex flex-col justify-between bg-base-200 hover:border-stone-400/30 border border-transparent border-dashed rounded-xl p-8 transition-all duration-300 shadow-md h-full hover:shadow-lg hover:shadow-stone-950/40"
              >
                <div>
                  <!-- Massive Impact Metric Highlight -->
                  <div class="mb-6 pb-6 border-b border-stone-850">
                    <span class="block text-stone-500 text-[10px] font-mono uppercase tracking-widest mb-1.5">
                      Impacto Clave / ROI
                    </span>
                    <div class="text-2xl font-bold font-mono text-secondary tracking-tight">
                      {entry.data.impactMetric}
                    </div>
                  </div>

                  <div class="mb-4">
                    <span class="text-xs font-mono text-secondary uppercase tracking-wider bg-base-100 px-3 py-1 rounded border border-stone-800 inline-block mb-3">
                      Cliente: {entry.data.clientName}
                    </span>
                    <h3 class="text-2xl font-bold text-primary group-hover:text-secondary transition-colors leading-tight">
                      {entry.data.title}
                    </h3>
                  </div>

                  <p class="text-stone-400 text-sm leading-relaxed mb-8">
                    {entry.data.description}
                  </p>
                </div>

                <div class="mt-auto">
                  {entry.data.technologies && entry.data.technologies.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mb-6">
                      {entry.data.technologies.map((tech: string) => (
                        <span class="px-2 py-0.5 text-[10px] font-mono bg-base-100 border border-stone-800 text-stone-400 rounded">
                          {tech}
                        </span>
                      ))}
                    </div>
                  )}

                  <div class="flex items-center text-xs font-mono font-bold text-secondary group-hover:text-primary transition-colors">
                    Ver Caso de Estudio
                    <ArrowRight class="w-4 h-4 ml-1.5 transition-transform group-hover:translate-x-1" stroke-width="1.5" />
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</Layout>
