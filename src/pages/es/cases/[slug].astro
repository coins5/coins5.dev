---
import { getCollection, render } from "astro:content";
import { ArrowLeft, ArrowRight, Calendar, MessageSquare } from "@lucide/astro";
import Layout from "../../../layouts/Layout.astro";
import { siteConfig, getWhatsAppUrl } from "../../../config";

export async function getStaticPaths() {
  const caseEntries = await getCollection("cases");

  // Filter for Spanish cases strictly
  const esEntries = caseEntries.filter((entry) => entry.data.lang === "es");

  return esEntries.map((entry) => {
    const slug =
      entry.id
        .split("/")
        .pop()
        ?.replace(/\.(md|mdx)$/, "") || entry.id;
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allCases = await getCollection("cases");
const esCases = allCases
  .filter((e) => e.data.lang === "es")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentIndex = esCases.findIndex((e) => e.id === entry.id);
const nextCase =
  currentIndex >= 0 && currentIndex < esCases.length - 1
    ? esCases[currentIndex + 1]
    : esCases[0] !== entry
    ? esCases[0]
    : null;

const nextSlug = nextCase
  ? nextCase.id
      .split("/")
      .pop()
      ?.replace(/\.(md|mdx)$/, "") || nextCase.id
  : null;

import { getCaseStudySchema, getBreadcrumbSchema } from "../../../utils/seo-schemas";

const currentSlug = Astro.params.slug;
const canonicalUrl = `${siteConfig.siteUrl}/es/cases/${currentSlug}/`;
const caseSchema = [
  getCaseStudySchema(entry, canonicalUrl, "es"),
  getBreadcrumbSchema([
    { name: "Inicio", url: `${siteConfig.siteUrl}/es/` },
    { name: "Casos de Éxito", url: `${siteConfig.siteUrl}/es/cases/` },
    { name: entry.data.title, url: canonicalUrl },
  ]),
];
---

<Layout
  title={`${entry.data.title} | Coins5`}
  description={entry.data.description}
  lang="es"
  keywords={entry.data.keywords}
  ogImage={entry.data.ogImage}
  ogType="article"
  schema={caseSchema}
>
  <div class="relative py-12 md:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb & Back button -->
    <a
      href="/es/cases/"
      class="inline-flex items-center text-xs font-mono font-bold text-secondary mb-8 transition-colors group"
    >
      <ArrowLeft
        class="w-4 h-4 mr-2 transition-transform group-hover:-translate-x-1"
        stroke-width="2"
      />
      Volver a Casos de Éxito
    </a>

    <!-- Premium Header Dashboard Container -->
    <div class="mb-12 p-6 md:p-8 card-premium rounded-2xl shadow-xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Client details & Title -->
        <div class="lg:col-span-7">
          <div class="text-xs font-mono text-secondary uppercase tracking-widest mb-3 font-semibold">
            Caso de Estudio &bull; {entry.data.clientName}
          </div>
          <h1 class="text-3xl md:text-4xl font-extrabold text-primary tracking-tight leading-tight font-sans">
            {entry.data.title}
          </h1>
        </div>

        <!-- Massive Impact Metric Box -->
        <div class="lg:col-span-5">
          <div
            class="px-6 py-6 md:py-8 rounded-xl text-center flex flex-col justify-center items-center border"
            style="background-color: var(--card-inner-bg); border-color: var(--card-border);"
          >
            <span
              class="text-xs font-mono uppercase tracking-widest mb-2 opacity-70"
              style="color: var(--color-text-body);"
            >
              Impacto Clave y ROI
            </span>
            <div class="text-2xl md:text-3xl font-extrabold font-mono text-secondary tracking-tight">
              {entry.data.impactMetric}
            </div>
            <span
              class="text-[10px] font-mono mt-2 uppercase tracking-wider font-semibold"
              style="color: var(--badge-text);"
            >
              Resultado Verificado
            </span>
          </div>
        </div>
      </div>

      <!-- Tech Stack Badges row inside header -->
      {
        entry.data.technologies && entry.data.technologies.length > 0 && (
          <div
            class="mt-6 pt-6 border-t flex flex-wrap items-center gap-2"
            style="border-color: var(--card-border);"
          >
            <span
              class="text-xs font-mono uppercase mr-1 opacity-70"
              style="color: var(--color-text-body);"
            >
              Stack:
            </span>
            {entry.data.technologies.map((tech: string) => (
              <span
                class="px-2.5 py-1 text-xs font-mono rounded-md"
                style="background-color: var(--tech-pill-bg); border: 1px solid var(--tech-pill-border); color: var(--tech-pill-text);"
              >
                {tech}
              </span>
            ))}
          </div>
        )
      }
    </div>

    <!-- Premium Reading Layout with Adaptive Typography -->
    <article class="prose max-w-none transition-colors mb-16">
      <Content />
    </article>

    <!-- Case Navigation & Dedicated CRO Box -->
    <div
      class="pt-10 border-t space-y-8"
      style="border-color: var(--card-border);"
    >
      {
        nextCase && nextSlug && (
          <div class="flex items-center justify-between">
            <span
              class="text-xs font-mono uppercase tracking-widest opacity-70"
              style="color: var(--color-text-body);"
            >
              Siguiente Caso de Estudio
            </span>
            <a
              href={`/es/cases/${nextSlug}/`}
              class="inline-flex items-center text-sm font-bold text-primary hover:text-secondary group transition-colors"
            >
              <span>{nextCase.data.title}</span>
              <ArrowRight class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" stroke-width="2" />
            </a>
          </div>
        )
      }

      <div class="card-premium rounded-2xl p-8 text-center relative overflow-hidden">
        <h3 class="text-2xl font-bold text-primary mb-3 font-sans">
          ¿Necesitas una arquitectura de alto rendimiento para tu producto?
        </h3>
        <p
          class="text-sm max-w-xl mx-auto mb-6 leading-relaxed font-sans"
          style="color: var(--color-text-body);"
        >
          Revisemos las especificaciones de tu producto, diagrama de infraestructura y tiempos de entrega en una llamada técnica de 15 minutos.
        </p>

        <div class="flex flex-col sm:flex-row gap-3.5 justify-center items-center">
          <a
            href={siteConfig.calendlyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm px-6 py-2.5 h-auto rounded-lg font-bold transition-all hover:scale-[1.02] active:scale-[0.98] border-none"
            style="background-color: var(--cta-primary-bg); color: var(--cta-primary-text);"
          >
            <Calendar class="w-4 h-4 mr-2" stroke-width="2" />
            Agendar Llamada Técnica
          </a>
          <a
            href={getWhatsAppUrl("es", "cases")}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost btn-sm px-5 py-2.5 h-auto rounded-lg font-semibold border transition-all"
            style="border-color: var(--card-border); color: var(--color-text-body);"
          >
            <MessageSquare class="w-4 h-4 mr-2 text-secondary" stroke-width="2" />
            Conversar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
